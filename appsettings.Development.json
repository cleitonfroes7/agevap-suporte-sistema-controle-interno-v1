{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=app5p;User Id=root;Password=CHANGE_ME;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true
      }
    }
  },
  "FileLogging": {
    "Path": "Logs/app-dev.log",
    "MinLevel": "Information",
    "IncludeScopes": true,
    "MaxFileSizeBytes": 10485760,
    "MaxRetainedFiles": 5
  },
  "DataProtection": {
    "KeysPath": "App_Data/DataProtection-Keys"
  },
  "DatabaseInitialization": {
    "ApplyMigrations": false,
    "EnsureCreatedIfNoTables": true,
    "RunCompatibilityPatches": true
  },
  "AdminBootstrap": {
    "EnableLegacyAdminSeed": false,
    "EnableConfiguredAdminPromotion": false,
    "ConfiguredAdminEmail": ""
  }
}
