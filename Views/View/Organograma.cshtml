                    <ul class="org-admin__list">
                        <li>Histórico de alterações por usuário</li>
                        <li>Data da última atualização da área</li>
                        <li>Campo de observações internas</li>
                        <li>Permissões específicas por perfil</li>
                    </ul>
                </article>
            </div>
        </section>
