@section Scripts {
    <script>
        (() => {
            const canManageEmployees = @isAdmin.ToString().ToLowerInvariant();
            const nodes = [
                { id: 'assembleia', title: 'Assembleia Geral', type: 'governanca', status: 'institucional', role: 'Instância máxima', description: 'Instância superior de deliberação institucional.', summary: 'Ponto máximo da hierarquia institucional.', parent: null },
                { id: 'conselho-admin', title: 'Conselho de Administração', type: 'governanca', status: 'institucional', role: 'Governança estratégica', description: 'Conduz a governança administrativa da estrutura institucional.', summary: 'Conecta a instância máxima à gestão executiva.', parent: 'assembleia' },
                { id: 'conselho-fiscal', title: 'Conselho Fiscal', type: 'governanca', status: 'institucional', role: 'Controle fiscal', description: 'Órgão colegiado de acompanhamento e fiscalização.', summary: 'Atua como apoio de controle na estrutura superior.', parent: 'conselho-admin' },
                { id: 'controladoria', title: 'Controladoria', type: 'presidencia', status: 'institucional', role: 'Controle central', description: 'Unidade vinculada à alta governança com papel de controle e supervisão.', summary: 'Sustenta o monitoramento institucional.', parent: 'conselho-admin' },
                { id: 'presidencia', title: 'Presidência', type: 'presidencia', status: 'institucional', role: 'Chefia máxima executiva', description: 'Centro executivo do organograma, conectando governança superior, assessorias e diretorias.', summary: 'Articula conselhos, diretorias e operação institucional.', parent: 'conselho-admin' },
                { id: 'assessoria-presidencia', title: 'Assessoria', type: 'presidencia', status: 'institucional', role: 'Apoio da presidência', description: 'Assessoria direta da presidência para suporte institucional e técnico.', summary: 'Unidade de apoio imediato da presidência.', parent: 'presidencia' },

                { id: 'dir-gestao', title: 'Diretoria de Gestão', type: 'diretoria', status: 'institucional', role: 'Diretoria executiva', description: 'Diretoria responsável pela gestão institucional e pelas superintendências regionais vinculadas.', summary: 'Concentra a coordenação da gestão e das superintendências.', parent: 'presidencia' },
                { id: 'dir-adm-fin', title: 'Diretoria Administrativo-Financeira', type: 'diretoria', status: 'institucional', role: 'Diretoria executiva', description: 'Diretoria com foco administrativo, financeiro e de suporte operacional.', summary: 'Coordena administração, finanças e rotinas de suporte.', parent: 'presidencia' },
                { id: 'dir-obras', title: 'Diretoria de Obras, Projetos e Estudos', type: 'diretoria', status: 'institucional', role: 'Diretoria executiva', description: 'Diretoria responsável por obras, projetos técnicos e estudos especializados.', summary: 'Agrupa as frentes técnicas de obras e projetos.', parent: 'presidencia' },
                { id: 'dir-planejamento', title: 'Diretoria de Planejamento e Ações Estratégicas', type: 'diretoria', status: 'institucional', role: 'Diretoria executiva', description: 'Diretoria dedicada ao planejamento institucional e às ações estratégicas.', summary: 'Lidera planejamento e ações estruturantes.', parent: 'presidencia' },

                { id: 'assessoria-gestao', title: 'Assessoria', type: 'planejada', status: 'planejada', role: 'Apoio da diretoria', description: 'Assessoria prevista para a Diretoria de Gestão.', summary: 'Mantida no desenho como estrutura futura.', parent: 'dir-gestao' },
                { id: 'assessoria-adm-fin', title: 'Assessoria', type: 'planejada', status: 'planejada', role: 'Apoio da diretoria', description: 'Assessoria prevista para a Diretoria Administrativo-Financeira.', summary: 'Mantida no desenho como estrutura futura.', parent: 'dir-adm-fin' },
                { id: 'assessoria-obras', title: 'Assessoria', type: 'implementada', status: 'implementada', role: 'Apoio da diretoria', description: 'Assessoria vinculada à Diretoria de Obras, Projetos e Estudos.', summary: 'Apoio técnico direto da diretoria.', parent: 'dir-obras' },
                { id: 'assessoria-planejamento', title: 'Assessoria', type: 'implementada', status: 'implementada', role: 'Apoio da diretoria', description: 'Assessoria vinculada à Diretoria de Planejamento e Ações Estratégicas.', summary: 'Apoio próximo às ações estratégicas.', parent: 'dir-planejamento' },

                { id: 'super-agevap', title: 'Superintendência Regional AGEVAP', type: 'planejada', status: 'planejada', role: 'Superintendência regional', description: 'Estrutura regional AGEVAP mapeada e mantida visível como unidade ainda não implantada.', summary: 'Superintendência prevista na arquitetura institucional.', parent: 'dir-gestao' },
                { id: 'super-agedoce', title: 'Superintendência Regional AGEDOCE', type: 'implementada', status: 'implementada', role: 'Superintendência regional', description: 'Superintendência regional AGEDOCE atualmente implantada.', summary: 'Estrutura regional ativa no desenho institucional.', parent: 'dir-gestao' },
                { id: 'super-agegrande', title: 'Superintendência Regional AGEGRANDE', type: 'implementada', status: 'implementada', role: 'Superintendência regional', description: 'Superintendência regional AGEGRANDE atualmente implantada.', summary: 'Estrutura regional ativa no desenho institucional.', parent: 'dir-gestao' },
                { id: 'super-agegoias', title: 'Superintendência Regional AGEGOIÁS', type: 'implementada', status: 'implementada', role: 'Superintendência regional', description: 'Superintendência regional AGEGOIÁS atualmente implantada.', summary: 'Estrutura regional ativa no desenho institucional.', parent: 'dir-gestao' },

                { id: 'ger-comunicacao', title: 'Gerência de Comunicação', type: 'implementada', status: 'implementada', role: 'Gerência', description: 'Gerência de comunicação vinculada diretamente à Presidência.', summary: 'Frente institucional de comunicação.', parent: 'presidencia' },
                { id: 'ger-ceivap', title: 'Gerência CEIVAP', type: 'implementada', status: 'implementada', role: 'Gerência', description: 'Gerência vinculada à estrutura regional AGEVAP.', summary: 'Unidade operacional já implantada.', parent: 'super-agevap' },
                { id: 'ger-cbhs', title: 'Gerência CBHs', type: 'implementada', status: 'implementada', role: 'Gerência', description: 'Gerência vinculada à estrutura regional AGEVAP.', summary: 'Unidade operacional já implantada.', parent: 'super-agevap' },
                { id: 'ger-guandu-big', title: 'Gerência Guandu-BIG', type: 'implementada', status: 'implementada', role: 'Gerência', description: 'Gerência vinculada à estrutura regional AGEVAP.', summary: 'Unidade operacional já implantada.', parent: 'super-agevap' },
                { id: 'ger-bg', title: 'Gerência BG', type: 'implementada', status: 'implementada', role: 'Gerência', description: 'Gerência vinculada à estrutura regional AGEVAP.', summary: 'Unidade operacional já implantada.', parent: 'super-agevap' },
                { id: 'ger-ps1-ps2', title: 'Gerência PS1/PS2', type: 'planejada', status: 'planejada', role: 'Gerência', description: 'Gerência prevista na estrutura regional AGEVAP.', summary: 'Mantida visível como unidade ainda não implantada.', parent: 'super-agevap' },

                { id: 'ger-comites-agedoce', title: 'Gerência de Atendimento aos Comitês - AGEDOCE', type: 'implementada', status: 'implementada', role: 'Gerência', description: 'Gerência vinculada à estrutura regional AGEDOCE.', summary: 'Atendimento institucional aos comitês.', parent: 'super-agedoce' },
                { id: 'ger-comites-agegrande', title: 'Gerência de Atendimento aos Comitês - AGEGRANDE', type: 'planejada', status: 'planejada', role: 'Gerência', description: 'Gerência prevista para a estrutura regional AGEGRANDE.', summary: 'Área mapeada para implantação futura.', parent: 'super-agegrande' },
                { id: 'ger-fundos-rh', title: 'Gerência de Fundos e Recursos Hídricos', type: 'implementada', status: 'implementada', role: 'Gerência', description: 'Gerência vinculada à estrutura regional AGEGOIÁS.', summary: 'Coordena fundos e recursos hídricos.', parent: 'super-agegoias' },
                { id: 'ger-fundos-ambientais', title: 'Gerência de Fundos Ambientais', type: 'implementada', status: 'implementada', role: 'Gerência', description: 'Gerência vinculada à estrutura regional AGEGOIÁS.', summary: 'Coordena fundos ambientais.', parent: 'super-agegoias' },

                { id: 'ger-administrativa', title: 'Gerência Administrativa', type: 'implementada', status: 'implementada', role: 'Gerência', description: 'Gerência administrativa vinculada à Diretoria Administrativo-Financeira.', summary: 'Suporte administrativo central.', parent: 'dir-adm-fin' },
                { id: 'ger-financeira', title: 'Gerência Financeira', type: 'implementada', status: 'implementada', role: 'Gerência', description: 'Gerência financeira vinculada à Diretoria Administrativo-Financeira.', summary: 'Coordena a frente financeira executiva.', parent: 'dir-adm-fin' },

                { id: 'ger-recursos-hidricos', title: 'Gerência de Recursos Hídricos', type: 'planejada', status: 'planejada', role: 'Gerência', description: 'Gerência prevista na Diretoria de Obras, Projetos e Estudos.', summary: 'Unidade ainda não implantada.', parent: 'dir-obras' },
                { id: 'ger-meio-ambiente', title: 'Gerência de Meio Ambiente', type: 'planejada', status: 'planejada', role: 'Gerência', description: 'Gerência prevista na Diretoria de Obras, Projetos e Estudos.', summary: 'Unidade ainda não implantada.', parent: 'dir-obras' },
                { id: 'ger-obras', title: 'Gerência de Obras', type: 'implementada', status: 'implementada', role: 'Gerência', description: 'Gerência de obras vinculada à Diretoria de Obras, Projetos e Estudos.', summary: 'Unidade operacional implantada.', parent: 'dir-obras' },
                { id: 'ger-projetos', title: 'Gerência de Projetos', type: 'planejada', status: 'planejada', role: 'Gerência', description: 'Gerência prevista na Diretoria de Obras, Projetos e Estudos.', summary: 'Unidade ainda não implantada.', parent: 'dir-obras' },

                { id: 'ger-planejamento', title: 'Gerência de Planejamento', type: 'planejada', status: 'planejada', role: 'Gerência', description: 'Gerência prevista na Diretoria de Planejamento e Ações Estratégicas.', summary: 'Unidade ainda não implantada.', parent: 'dir-planejamento' },
                { id: 'ger-acoes-estrategicas', title: 'Gerência de Ações Estratégicas', type: 'planejada', status: 'planejada', role: 'Gerência', description: 'Gerência prevista na Diretoria de Planejamento e Ações Estratégicas.', summary: 'Unidade ainda não implantada.', parent: 'dir-planejamento' }
            ];

            const boardRows = [
                ['assembleia'],
                ['conselho-admin'],
                ['conselho-fiscal', 'presidencia', 'assessoria-presidencia', 'controladoria'],
                ['dir-gestao', 'assessoria-gestao', 'dir-adm-fin', 'assessoria-adm-fin', 'dir-obras', 'assessoria-obras', 'dir-planejamento', 'assessoria-planejamento'],
                ['super-agevap', 'super-agedoce', 'super-agegrande', 'super-agegoias'],
                ['ger-comunicacao', 'ger-ceivap', 'ger-cbhs', 'ger-guandu-big', 'ger-bg', 'ger-comites-agedoce', 'ger-comites-agegrande', 'ger-recursos-hidricos', 'ger-ps1-ps2'],
                ['ger-fundos-rh', 'ger-fundos-ambientais', 'ger-administrativa', 'ger-financeira', 'ger-obras', 'ger-meio-ambiente', 'ger-projetos', 'ger-planejamento', 'ger-acoes-estrategicas']
            ];

            const groupRoots = [
                { id: 'presidencia', label: 'Presidência e estrutura executiva', hint: 'Leitura macro da presidência, assessorias e diretorias.' },
                { id: 'dir-gestao', label: 'Diretoria de Gestão', hint: 'Superintendências regionais e unidades subordinadas.' },
                { id: 'dir-adm-fin', label: 'Diretoria Administrativo-Financeira', hint: 'Administração, finanças e suporte central.' },
                { id: 'dir-obras', label: 'Diretoria de Obras, Projetos e Estudos', hint: 'Obras, projetos e frentes técnicas associadas.' },
                { id: 'dir-planejamento', label: 'Diretoria de Planejamento e Ações Estratégicas', hint: 'Planejamento e ações estratégicas da instituição.' }
            ];

            const state = {
                activeTab: 'organograma',
                selectedNodeId: 'conselho-admin',
                selectedGroupId: 'presidencia'
            };

            const nodeMap = new Map(nodes.map((node) => [node.id, node]));
            const childrenMap = new Map();
            nodes.forEach((node) => {
                if (!node.parent) return;
                const current = childrenMap.get(node.parent) || [];
                current.push(node.id);
                childrenMap.set(node.parent, current);
            });

            const boardEl = document.getElementById('orgBoard');
            const boardSvgEl = document.getElementById('orgBoardSvg');
            const boardRowsEl = document.getElementById('orgBoardRows');
            const groupListEl = document.getElementById('orgGroupList');
            const explorerTitleEl = document.getElementById('orgExplorerTitle');
            const explorerTextEl = document.getElementById('orgExplorerText');
            const breadcrumbEl = document.getElementById('orgBreadcrumb');
            const columnsEl = document.getElementById('orgColumns');
            const detailEyebrowEl = document.getElementById('orgDetailEyebrow');
            const detailTitleEl = document.getElementById('orgDetailTitle');
            const detailIconEl = document.getElementById('orgDetailIcon');
            const detailTextEl = document.getElementById('orgDetailText');
            const detailContextEl = document.getElementById('orgDetailContext');
            const detailChipsEl = document.getElementById('orgDetailChips');
            const detailMetricsEl = document.getElementById('orgDetailMetrics');
            const viewUnitFlowButtonEl = document.getElementById('orgViewUnitFlowButton');
            const focusModalEl = document.getElementById('orgFocusModal');
            const focusModalCloseEl = document.getElementById('orgFocusModalClose');
            const focusModalCancelEl = document.getElementById('orgFocusModalCancel');
            const focusTreeEl = document.getElementById('orgFocusTree');
            const focusTreeSvgEl = document.getElementById('orgFocusTreeSvg');
            const focusTreeRowsEl = document.getElementById('orgFocusTreeRows');
            const detailEmployeesEl = document.getElementById('orgDetailEmployees');
            const addEmployeeButtonEl = document.getElementById('orgAddEmployeeButton');
            const employeeModalEl = document.getElementById('orgEmployeeModal');
            const employeeModalCloseEl = document.getElementById('orgEmployeeModalClose');
            const employeeModalCancelEl = document.getElementById('orgEmployeeModalCancel');
            const employeeSectorEl = document.getElementById('orgEmployeeSector');
            const employeeIdEl = document.getElementById('orgEmployeeId');
            const employeeUnitIdEl = document.getElementById('orgEmployeeUnitId');
            const employeeFormEl = document.getElementById('orgEmployeeForm');
            const employeeCache = new Map();

            function escapeHtml(value) {
                return String(value ?? '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function getNode(nodeId) {
                return nodeMap.get(nodeId) || null;
            }

            function getChildren(nodeId) {
                return (childrenMap.get(nodeId) || []).map((id) => getNode(id)).filter(Boolean);
            }

            function getAncestors(nodeId) {
                const path = [];
                let current = getNode(nodeId);
                while (current) {
                    path.unshift(current);
                    current = current.parent ? getNode(current.parent) : null;
                }
                return path;
            }

            function getDescendants(nodeId) {
                const result = [];
                const queue = [...(childrenMap.get(nodeId) || [])];
                while (queue.length) {
                    const id = queue.shift();
                    const node = getNode(id);
                    if (!node) continue;
                    result.push(node);
                    queue.push(...(childrenMap.get(id) || []));
                }
                return result;
            }

            function isOnPath(nodeId, selectedId) {
                if (!selectedId) return false;
                const selectedPath = new Set(getAncestors(selectedId).map((node) => node.id));
                if (selectedPath.has(nodeId)) return true;
                return getAncestors(nodeId).some((node) => node.id === selectedId);
            }

            function getStatusLabel(node) {
                if (node.status === 'implementada') return 'Implementada';
                if (node.status === 'planejada') return 'Planejada';
                return 'Institucional';
            }

            function getXsrfToken() {
                const match = document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]+)/);
                return match ? decodeURIComponent(match[1]) : '';
            }

            async function requestJson(url, options = {}) {
                const headers = new Headers(options.headers || {});
                if (!headers.has('Content-Type') && options.body) {
                    headers.set('Content-Type', 'application/json; charset=UTF-8');
                }

                const xsrfToken = getXsrfToken();
                if (xsrfToken && !headers.has('X-CSRF-TOKEN')) {
                    headers.set('X-CSRF-TOKEN', xsrfToken);
                }

                const response = await fetch(url, {
                    credentials: 'same-origin',
                    ...options,
                    headers
                });

                const data = await response.json().catch(() => ({}));
                if (!response.ok || data.success === false) {
                    throw new Error(data.message || 'Não foi possível concluir a operação.');
                }

                return data;
            }

            async function getEmployeesForNode(nodeId) {
                const result = await requestJson(`/api/organograma/funcionarios?unidade_id=${encodeURIComponent(nodeId)}`);
                return Array.isArray(result.items) ? result.items : [];
            }

            async function loadEmployees(nodeId, forceRefresh = false) {
                if (!nodeId) return [];
                if (!forceRefresh && employeeCache.has(nodeId)) {
                    return employeeCache.get(nodeId) || [];
                }

                const employees = await getEmployeesForNode(nodeId);
                employeeCache.set(nodeId, employees);
                return employees;
            }

            function getColorClass(node) {
                if (node.type === 'governanca') return 'org-card--governanca';
                if (node.type === 'presidencia') return 'org-card--presidencia';
                if (node.type === 'diretoria') return 'org-card--diretoria';
                if (node.status === 'planejada') return 'org-card--planejada';
                return 'org-card--implementada';
            }

            function getSizeClass(node) {
                if (!node) return '';
                if (node.id === 'assembleia' || node.id === 'conselho-admin') return 'org-card--hero';
                if (node.id === 'conselho-fiscal' || node.id === 'controladoria' || node.id === 'presidencia') return 'org-card--leader';
                if (node.id === 'assessoria-presidencia' || String(node.id).startsWith('assessoria-')) return 'org-card--support';
                if (String(node.id).startsWith('super-')) return 'org-card--regional';
                if (String(node.id).startsWith('ger-')) return 'org-card--manager';
                return '';
            }

            function getIconClass(node) {
                if (node.id === 'assembleia') return 'fa-solid fa-users';
                if (node.id.includes('conselho')) return 'fa-solid fa-shield-halved';
                if (node.id === 'controladoria') return 'fa-solid fa-clipboard-check';
                if (node.id === 'presidencia') return 'fa-solid fa-user-tie';
                if (node.id.startsWith('assessoria')) return 'fa-solid fa-comments';
                if (node.type === 'diretoria') return 'fa-solid fa-building';
                if (node.id.startsWith('super-')) return 'fa-solid fa-sitemap';
                if (node.id.includes('finance')) return 'fa-solid fa-circle-dollar-to-slot';
                if (node.id.includes('recursos') || node.id.includes('ambient')) return 'fa-solid fa-droplet';
                if (node.id.includes('planejamento') || node.id.includes('acoes')) return 'fa-solid fa-chart-line';
                if (node.id.includes('obras') || node.id.includes('projetos')) return 'fa-solid fa-helmet-safety';
                return 'fa-solid fa-gears';
            }

            function renderBoardCard(nodeId) {
                const node = getNode(nodeId);
                if (!node) return '';

                const active = state.selectedNodeId === node.id ? 'is-active' : '';
                const path = isOnPath(node.id, state.selectedNodeId) ? 'is-path' : '';
                const dimmed = state.selectedNodeId && !path ? 'is-dimmed' : '';

                return `
                    <button type="button"
                        class="org-card ${getColorClass(node)} ${getSizeClass(node)} ${active} ${path} ${dimmed}"
                        data-org-node-id="${escapeHtml(node.id)}">
                        <span class="org-card__topline">
                            <span class="org-card__icon" aria-hidden="true"><i class="${getIconClass(node)}"></i></span>
                            <span class="org-card__title">${escapeHtml(node.title)}</span>
                        </span>
                        <div class="org-card__meta">
                            <span class="org-pill">${escapeHtml(getStatusLabel(node))}</span>
                        </div>
                    </button>
                `;
            }

            function bindBoardCards() {
                boardRowsEl.querySelectorAll('[data-org-node-id]').forEach((button) => {
                    button.addEventListener('click', () => {
                        const nodeId = button.dataset.orgNodeId || '';
                        state.selectedNodeId = nodeId;
                        const rootGroup = groupRoots.find((group) => getAncestors(nodeId).some((item) => item.id === group.id));
                        if (rootGroup) {
                            state.selectedGroupId = rootGroup.id;
                        }
                        renderAll();
                    });
                });
            }

            function drawBoardLinks() {
                if (!boardEl || !boardSvgEl) return;

                boardSvgEl.innerHTML = '';
                const boardRect = boardEl.getBoundingClientRect();
                if (!boardRect.width || !boardRect.height) return;
                boardSvgEl.setAttribute('viewBox', `0 0 ${boardRect.width} ${boardRect.height}`);

                nodes.forEach((node) => {
                    if (!node.parent) return;

                    const from = boardEl.querySelector(`[data-org-node-id="${CSS.escape(node.parent)}"]`);
                    const to = boardEl.querySelector(`[data-org-node-id="${CSS.escape(node.id)}"]`);
                    if (!from || !to) return;

                    const fromRect = from.getBoundingClientRect();
                    const toRect = to.getBoundingClientRect();
                    const sameRow = from.closest('.org-row') === to.closest('.org-row');
                    const startX = (sameRow && fromRect.left <= toRect.left ? fromRect.right : fromRect.left + (fromRect.width / 2)) - boardRect.left + boardEl.scrollLeft;
                    const startY = (sameRow ? fromRect.top + (fromRect.height / 2) : fromRect.bottom) - boardRect.top + boardEl.scrollTop;
                    const endX = (sameRow && fromRect.left <= toRect.left ? toRect.left : toRect.left + (toRect.width / 2)) - boardRect.left + boardEl.scrollLeft;
                    const endY = (sameRow ? toRect.top + (toRect.height / 2) : toRect.top) - boardRect.top + boardEl.scrollTop;
                    const highlighted = isOnPath(node.id, state.selectedNodeId) && isOnPath(node.parent, state.selectedNodeId);
                    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                    const dashed = node.id.startsWith('assessoria-') || node.id === 'controladoria';
                    const dimmed = state.selectedNodeId && !highlighted;
                    path.setAttribute('class', `org-link ${dashed ? 'org-link--dashed' : ''} ${dimmed ? 'org-link--dimmed' : ''} ${highlighted ? 'org-link--highlight' : ''}`);
                    const midY = startY + ((endY - startY) / 2);
                    const pathData = sameRow
                        ? `M ${startX} ${startY} H ${endX}`
                        : `M ${startX} ${startY} V ${midY} H ${endX} V ${endY}`;
                    path.setAttribute('d', pathData);
                    boardSvgEl.appendChild(path);
                });
            }

            function renderOverview() {
                boardRowsEl.innerHTML = boardRows.map((row, index) => {
                    const rowClass =
                        index === 0 ? 'org-row org-row--single' :
                        index === 1 ? 'org-row org-row--duo' :
                        index === 2 ? 'org-row org-row--trio' :
                        index === 3 ? 'org-row org-row--directors' :
                        index === 4 ? 'org-row org-row--superintendencias' :
                        index === 5 ? 'org-row org-row--gerencias org-row--gerencias-principais' :
                        'org-row org-row--gerencias org-row--gerencias-planejadas';

                    return `
                    <div class="${rowClass}">
                        ${row.map((nodeId) => renderBoardCard(nodeId)).join('')}
                    </div>
                `;
                }).join('');

                bindBoardCards();
                requestAnimationFrame(drawBoardLinks);
            }

            function renderGroupButtons(targetEl, buttonAttribute) {
                if (!targetEl) return;

                targetEl.innerHTML = groupRoots.map((group) => {
                    const descendants = getDescendants(group.id);
                    const active = state.selectedGroupId === group.id ? 'is-active' : '';
                    return `
                        <button type="button" class="org-group-button ${active}" ${buttonAttribute}="${escapeHtml(group.id)}">
                            <span class="org-group-button__title">${escapeHtml(group.label)}</span>
                            <span class="org-group-button__meta">${escapeHtml(group.hint)}</span>
                            <span class="org-group-button__meta">${escapeHtml(descendants.length + 1)} unidade(s) neste bloco</span>
                        </button>
                    `;
                }).join('');

                targetEl.querySelectorAll(`[${buttonAttribute}]`).forEach((button) => {
                    button.addEventListener('click', () => {
                        const groupId = button.getAttribute(buttonAttribute) || '';
                        state.selectedGroupId = groupId;
                        state.selectedNodeId = groupId;
                        renderAll();
                    });
                });
            }

            function renderGroups() {
                renderGroupButtons(groupListEl, 'data-org-group-id');
            }

            function buildExplorerColumns(rootId) {
                const root = getNode(rootId);
                if (!root) return [];

                const level0 = [root];
                const level1 = getChildren(root.id);
                const level2 = level1.flatMap((node) => getChildren(node.id));
                const level3 = level2.flatMap((node) => getChildren(node.id));

                return [
                    { title: 'Chefia central', items: level0, empty: 'Selecione um bloco para abrir a chefia principal.' },
                    { title: 'Apoios e vínculos diretos', items: level1, empty: 'Nenhuma unidade direta mapeada neste bloco.' },
                    { title: 'Estrutura subordinada', items: level2, empty: 'O próximo nível aparecerá quando houver estrutura vinculada.' },
                    { title: 'Base operacional', items: level3, empty: 'As áreas operacionais finais aparecerão aqui quando existirem.' }
                ];
            }

            function renderMiniCard(node) {
                const active = state.selectedNodeId === node.id ? 'is-active' : '';
                return `
                    <button type="button" class="org-mini-card ${active}" data-org-mini-id="${escapeHtml(node.id)}">
                        <span class="org-mini-card__title">${escapeHtml(node.title)}</span>
                        <div class="org-mini-card__meta">
                            <span class="org-status org-status--${escapeHtml(node.status)}">${escapeHtml(getStatusLabel(node))}</span>
                            <span>${escapeHtml(node.role)}</span>
                        </div>
                    </button>
                `;
            }

            function renderExplorer() {
                const root = getNode(state.selectedGroupId);
                const groupMeta = groupRoots.find((group) => group.id === state.selectedGroupId);
                if (!root || !groupMeta) return;

                explorerTitleEl.textContent = groupMeta.label;
                explorerTextEl.textContent = groupMeta.hint;

                breadcrumbEl.innerHTML = getAncestors(root.id).map((node) => `
                    <span class="org-breadcrumb__item">${escapeHtml(node.title)}</span>
                `).join('');

                const columns = buildExplorerColumns(root.id);
                columnsEl.innerHTML = columns.map((column) => `
                    <section class="org-column">
                        <span class="org-column__title">${escapeHtml(column.title)}</span>
                        ${column.items.length
                            ? `<div class="org-column__list">${column.items.map((node) => renderMiniCard(node)).join('')}</div>`
                            : `<div class="org-column__empty">${escapeHtml(column.empty)}</div>`}
                    </section>
                `).join('');

                columnsEl.querySelectorAll('[data-org-mini-id]').forEach((button) => {
                    button.addEventListener('click', () => {
                        state.selectedNodeId = button.dataset.orgMiniId || '';
                        renderAll();
                    });
                });
            }


            function getNodeTier(node) {
                if (!node) return 99;
                if (node.id === 'assembleia') return 0;
                if (node.id === 'conselho-admin' || node.id === 'conselho-fiscal') return 1;
                if (node.id === 'presidencia' || node.id === 'controladoria' || node.id === 'assessoria-presidencia') return 2;
                if (node.type === 'diretoria') return 3;
                if (String(node.id || '').startsWith('assessoria-')) return 4;
                if (String(node.id || '').startsWith('super-')) return 5;
                return 6;
            }

            function uniqueNodes(items) {
                const seen = new Set();
                return items.filter((item) => {
                    if (!item || seen.has(item.id)) return false;
                    seen.add(item.id);
                    return true;
                });
            }

            function buildFocusLevels(rootNode) {
                const path = getAncestors(rootNode.id);
                const pathIds = new Set(path.map((item) => item.id));
                const levels = [];

                path.forEach((item) => {
                    const tier = getNodeTier(item);
                    const row = item.parent
                        ? uniqueNodes(getChildren(item.parent).filter((child) => getNodeTier(child) === tier && (pathIds.has(child.id) || child.id === item.id)))
                        : [item];

                    if (!row.length) return;

                    const signature = row.map((node) => node.id).join('|');
                    if (!levels.some((existing) => existing.map((node) => node.id).join('|') === signature)) {
                        levels.push(row);
                    }
                });

                const childrenByTier = new Map();
                getChildren(rootNode.id).forEach((child) => {
                    const tier = getNodeTier(child);
                    const items = childrenByTier.get(tier) || [];
                    items.push(child);
                    childrenByTier.set(tier, items);
                });

                Array.from(childrenByTier.keys())
                    .sort((a, b) => a - b)
                    .forEach((tier) => {
                        levels.push(uniqueNodes(childrenByTier.get(tier) || []));
                    });

                return levels.filter((row) => row.length);
            }

            function renderFocusCard(node, selectedId) {
                const active = node.id === selectedId ? 'is-active is-path' : '';
                return `
                    <button type="button"
                        class="org-card ${getColorClass(node)} ${getSizeClass(node)} ${active}"
                        data-org-focus-node-id="${escapeHtml(node.id)}">
                        <span class="org-card__topline">
                            <span class="org-card__icon" aria-hidden="true"><i class="${getIconClass(node)}"></i></span>
                            <span class="org-card__title">${escapeHtml(node.title)}</span>
                        </span>
                        <div class="org-card__meta">
                            <span class="org-pill">${escapeHtml(getStatusLabel(node))}</span>
                        </div>
                    </button>
                `;
            }

            function drawFocusLinks() {
                if (!focusTreeEl || !focusTreeSvgEl) return;

                focusTreeSvgEl.innerHTML = '';
                const treeRect = focusTreeEl.getBoundingClientRect();
                if (!treeRect.width || !treeRect.height) return;
                focusTreeSvgEl.setAttribute('viewBox', `0 0 ${treeRect.width} ${treeRect.height}`);

                const renderedIds = new Set(
                    Array.from(focusTreeEl.querySelectorAll('[data-org-focus-node-id]'))
                        .map((element) => element.getAttribute('data-org-focus-node-id'))
                );

                nodes.forEach((node) => {
                    if (!node.parent || !renderedIds.has(node.id) || !renderedIds.has(node.parent)) return;

                    const from = focusTreeEl.querySelector(`[data-org-focus-node-id="${CSS.escape(node.parent)}"]`);
                    const to = focusTreeEl.querySelector(`[data-org-focus-node-id="${CSS.escape(node.id)}"]`);
                    if (!from || !to) return;

                    const fromRect = from.getBoundingClientRect();
                    const toRect = to.getBoundingClientRect();
                    const sameRow = from.closest('.org-row') === to.closest('.org-row');
                    const startX = (sameRow && fromRect.left <= toRect.left ? fromRect.right : fromRect.left + (fromRect.width / 2)) - treeRect.left + focusTreeEl.scrollLeft;
                    const startY = (sameRow ? fromRect.top + (fromRect.height / 2) : fromRect.bottom) - treeRect.top + focusTreeEl.scrollTop;
                    const endX = (sameRow && fromRect.left <= toRect.left ? toRect.left : toRect.left + (toRect.width / 2)) - treeRect.left + focusTreeEl.scrollLeft;
                    const endY = (sameRow ? toRect.top + (toRect.height / 2) : toRect.top) - treeRect.top + focusTreeEl.scrollTop;

                    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                    const highlighted = isOnPath(node.id, state.selectedNodeId) && isOnPath(node.parent, state.selectedNodeId);
                    const dashed = node.id.startsWith('assessoria-') || node.id === 'controladoria';
                    const dimmed = state.selectedNodeId && !highlighted;
                    path.setAttribute('class', `org-link ${dashed ? 'org-link--dashed' : ''} ${dimmed ? 'org-link--dimmed' : ''} ${highlighted ? 'org-link--highlight' : ''}`);
                    const midY = startY + ((endY - startY) / 2);
                    const pathData = sameRow
                        ? `M ${startX} ${startY} H ${endX}`
                        : `M ${startX} ${startY} V ${midY} H ${endX} V ${endY}`;
                    path.setAttribute('d', pathData);
                    focusTreeSvgEl.appendChild(path);
                });
            }

            async function renderDetail() {
                const node = getNode(state.selectedNodeId) || getNode('presidencia');
                if (!node) return;

                const ancestors = getAncestors(node.id);
                const children = getChildren(node.id);
                const descendants = getDescendants(node.id);
                const employees = await loadEmployees(node.id);

                detailEyebrowEl.textContent = node.role;
                detailTitleEl.textContent = node.title;
                detailTextEl.textContent = node.description;
                if (detailIconEl) {
                    detailIconEl.innerHTML = `<i class="${getIconClass(node)}"></i>`;
                }
                if (detailContextEl) {
                    const parent = node.parent ? getNode(node.parent) : null;
                    detailContextEl.textContent = parent
                        ? `Vinculada diretamente a ${parent.title}. A unidade possui ${children.length} vínculo(s) direto(s) e ${descendants.length} área(s) em sua estrutura.`
                        : 'Unidade no nível superior da estrutura institucional.';
                }

                detailChipsEl.innerHTML = `
                    <span class="org-status org-status--${escapeHtml(node.status)}">${escapeHtml(getStatusLabel(node))}</span>
                    <span class="org-status org-status--institucional">${escapeHtml(ancestors.length)} nível(is) de percurso</span>
                    <span class="org-status org-status--institucional">${escapeHtml(children.length)} vínculo(s) direto(s)</span>
                    <span class="org-status org-status--institucional">${escapeHtml(descendants.length)} área(s) abaixo deste ponto</span>
                `;

                if (detailMetricsEl) {
                    detailMetricsEl.innerHTML = `
                        <div class="org-detail__metric">
                            <span class="org-detail__metric-label">Posição</span>
                            <strong class="org-detail__metric-value">${escapeHtml(ancestors.length)}º</strong>
                        </div>
                        <div class="org-detail__metric">
                            <span class="org-detail__metric-label">Vínculos diretos</span>
                            <strong class="org-detail__metric-value">${escapeHtml(children.length)}</strong>
                        </div>
                        <div class="org-detail__metric">
                            <span class="org-detail__metric-label">Estrutura abaixo</span>
                            <strong class="org-detail__metric-value">${escapeHtml(descendants.length)}</strong>
                        </div>
                        <div class="org-detail__metric">
                            <span class="org-detail__metric-label">Pessoas</span>
                            <strong class="org-detail__metric-value">${escapeHtml(employees.length)}</strong>
                        </div>
                    `;
                }

                if (detailEmployeesEl) {
                    detailEmployeesEl.innerHTML = employees.length
                        ? `
                            <div class="org-detail__employee-banner">
                                <strong>${escapeHtml(employees.length)} funcionário(s) vinculado(s) a este setor</strong>
                                <p>Os nomes abaixo confirmam os colaboradores já cadastrados nesta unidade do organograma.</p>
                                <div class="org-detail__employee-list">
                                    ${employees.map((employee, index) => `
                                        <div class="org-detail__employee-item">
                                            <button type="button" class="org-detail__employee-pill" data-org-employee-toggle="${index}" aria-expanded="false">
                                                <i class="fa-solid fa-user" aria-hidden="true"></i>
                                                ${escapeHtml(employee.nome || 'Sem nome')}
                                                <small>${escapeHtml(employee.cargo || 'Cargo não informado')}</small>
                                            </button>
                                            <div class="org-detail__employee-popover" data-org-employee-popover="${index}" hidden>
                                                <strong>${escapeHtml(employee.nome || 'Sem nome')}</strong>
                                                <p><strong>Cargo:</strong> ${escapeHtml(employee.cargo || 'Não informado')}</p>
                                                <p><strong>Telefone:</strong> ${escapeHtml(employee.telefone || 'Não informado')}</p>
                                                <p><strong>E-mail:</strong> ${escapeHtml(employee.email || 'Não informado')}</p>
                                                <p><strong>Local:</strong> ${escapeHtml(employee.local || 'Não informado')}</p>
                                                ${employee.observacoes ? `<p><strong>Observações:</strong> ${escapeHtml(employee.observacoes)}</p>` : ''}
                                            </div>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                        `
                        : `
                            <div class="org-detail__employee-banner">
                                <strong>Nenhum funcionário cadastrado neste setor</strong>
                                <p>Quando você adicionar um colaborador aqui, ele passará a aparecer nesta leitura contextual e no fluxo específico.</p>
                            </div>
                        `;

                    detailEmployeesEl.querySelectorAll('[data-org-employee-toggle]').forEach((button) => {
                        button.addEventListener('click', () => {
                            const popover = detailEmployeesEl.querySelector(`[data-org-employee-popover="${CSS.escape(button.dataset.orgEmployeeToggle || '')}"]`);
                            const isOpen = popover && !popover.hidden;

                            detailEmployeesEl.querySelectorAll('[data-org-employee-popover]').forEach((item) => {
                                item.hidden = true;
                            });
                            detailEmployeesEl.querySelectorAll('[data-org-employee-toggle]').forEach((item) => {
                                item.classList.remove('is-open');
                                item.setAttribute('aria-expanded', 'false');
                            });

                            if (popover && !isOpen) {
                                popover.hidden = false;
                                button.classList.add('is-open');
                                button.setAttribute('aria-expanded', 'true');
                            }
                        });
                    });
                }

                if (addEmployeeButtonEl) {
                    addEmployeeButtonEl.disabled = !node;
                }
                if (viewUnitFlowButtonEl) {
                    viewUnitFlowButtonEl.disabled = !node;
                }
            }

            function renderStats() {
                document.getElementById('orgStatTotal').textContent = String(nodes.length);
                document.getElementById('orgStatImplementadas').textContent = String(nodes.filter((node) => node.status === 'implementada').length);
                document.getElementById('orgStatPlanejadas').textContent = String(nodes.filter((node) => node.status === 'planejada').length);
                document.getElementById('orgStatChefias').textContent = String(nodes.filter((node) => ['governanca', 'presidencia', 'diretoria'].includes(node.type)).length);
            }

            function syncTabs() {
                document.querySelectorAll('[data-org-tab]').forEach((button) => {
                    button.classList.toggle('is-active', button.dataset.orgTab === state.activeTab);
                });

                document.querySelectorAll('[data-org-view]').forEach((view) => {
                    view.classList.toggle('is-active', view.dataset.orgView === state.activeTab);
                });
            }

            async function renderAll() {
                syncTabs();
                renderStats();
                renderOverview();
                renderGroups();
                renderExplorer();
                await renderDetail();
            }

            document.querySelectorAll('[data-org-tab]').forEach((button) => {
                button.addEventListener('click', () => {
                    state.activeTab = button.dataset.orgTab || 'organograma';
                    syncTabs();
                    requestAnimationFrame(drawBoardLinks);
                });
            });

            function openEmployeeModal(employee = null) {
                const node = getNode(state.selectedNodeId) || getNode('presidencia');
                if (!employeeModalEl || !employeeSectorEl || !employeeFormEl || !node) return;
                employeeFormEl.reset();
                if (employeeIdEl) {
                    employeeIdEl.value = employee?.id ? String(employee.id) : '';
                }
                if (employeeUnitIdEl) {
                    employeeUnitIdEl.value = employee?.unidade_id || node.id;
                }
                employeeSectorEl.value = employee?.unidade_nome || node.title;
                employeeFormEl.elements.namedItem('name').value = employee?.nome || '';
                employeeFormEl.elements.namedItem('role').value = employee?.cargo || '';
                employeeFormEl.elements.namedItem('phone').value = employee?.telefone || '';
                employeeFormEl.elements.namedItem('email').value = employee?.email || '';
                employeeFormEl.elements.namedItem('local').value = employee?.local || '';
                employeeFormEl.elements.namedItem('notes').value = employee?.observacoes || '';
                employeeModalEl.hidden = false;
                document.body.style.overflow = 'hidden';
            }

            function closeEmployeeModal() {
                if (!employeeModalEl) return;
                employeeModalEl.hidden = true;
                document.body.style.overflow = '';
            }

            async function renderFocusModal() {
                const node = getNode(state.selectedNodeId) || getNode('presidencia');
                if (!node || !focusTreeEl) return;

                const levels = buildFocusLevels(node);
                if (focusTreeRowsEl) {
                    focusTreeRowsEl.innerHTML = levels.map((levelItems) => `
                        <div class="org-row">
                            ${levelItems.map((item) => renderFocusCard(item, node.id)).join('')}
                        </div>
                    `).join('');

                    focusTreeRowsEl.querySelectorAll('[data-org-focus-node-id]').forEach((button) => {
                        button.addEventListener('click', async () => {
                            state.selectedNodeId = button.dataset.orgFocusNodeId || '';
                            await renderFocusModal();
                            await renderAll();
                        });
                    });
                }

                requestAnimationFrame(drawFocusLinks);
            }

            async function openFocusModal() {
                if (!focusModalEl) return;
                await renderFocusModal();
                focusModalEl.hidden = false;
                document.body.style.overflow = 'hidden';
            }

            function closeFocusModal() {
                if (!focusModalEl) return;
                focusModalEl.hidden = true;
                document.body.style.overflow = '';
            }

            addEmployeeButtonEl?.addEventListener('click', openEmployeeModal);
            viewUnitFlowButtonEl?.addEventListener('click', openFocusModal);
            employeeModalCloseEl?.addEventListener('click', closeEmployeeModal);
            employeeModalCancelEl?.addEventListener('click', closeEmployeeModal);
            employeeModalEl?.addEventListener('click', (event) => {
                if (event.target === employeeModalEl) {
                    closeEmployeeModal();
                }
            });
            focusModalCloseEl?.addEventListener('click', closeFocusModal);
            focusModalCancelEl?.addEventListener('click', closeFocusModal);
            focusModalEl?.addEventListener('click', (event) => {
                if (event.target === focusModalEl) {
                    closeFocusModal();
                }
            });

            employeeFormEl?.addEventListener('submit', async (event) => {
                event.preventDefault();
                if (!employeeFormEl) return;
                const formData = new FormData(employeeFormEl);
                const employeeId = String(formData.get('id') || '');
                const unidadeId = String(formData.get('unit_id') || '').trim();
                const unidadeNome = String(formData.get('sector') || '').trim();
                if (!unidadeId || !unidadeNome) {
                    window.alert('Selecione um setor válido antes de salvar o funcionário.');
                    return;
                }
                const payload = {
                    unidadeId,
                    unidadeNome,
                    nome: String(formData.get('name') || ''),
                    cargo: String(formData.get('role') || ''),
                    telefone: String(formData.get('phone') || ''),
                    email: String(formData.get('email') || ''),
                    local: String(formData.get('local') || ''),
                    observacoes: String(formData.get('notes') || '')
                };

                try {
                    if (employeeId) {
                        await requestJson(`/api/organograma/funcionarios/${encodeURIComponent(employeeId)}`, {
                            method: 'PUT',
                            body: JSON.stringify(payload)
                        });
                    } else {
                        await requestJson('/api/organograma/funcionarios', {
                            method: 'POST',
                            body: JSON.stringify(payload)
                        });
                    }

                    employeeCache.delete(unidadeId);

                    employeeFormEl.reset();
                    if (employeeSectorEl) {
                        employeeSectorEl.value = unidadeNome;
                    }
                    if (employeeIdEl) {
                        employeeIdEl.value = '';
                    }
                    if (employeeUnitIdEl) {
                        employeeUnitIdEl.value = unidadeId;
                    }
                    closeEmployeeModal();
                    await renderAll();
                    if (focusModalEl && !focusModalEl.hidden) {
                        await renderFocusModal();
                    }
                } catch (error) {
                    window.alert(error.message || 'Não foi possível salvar o funcionário.');
                }
            });

            window.addEventListener('resize', () => requestAnimationFrame(drawBoardLinks));
            boardEl?.addEventListener('scroll', () => requestAnimationFrame(drawBoardLinks));

            renderAll();
        })();
    </script>
}
