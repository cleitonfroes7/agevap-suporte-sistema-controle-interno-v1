@using versaoCsharp.Models
@{
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
    ViewData["Title"] = "Organograma";
    ViewData["PageDescription"] = "Leitura institucional interativa do organograma, com sinalização visual de áreas implementadas e planejadas.";
    ViewData["ActiveNav"] = "organograma";

    var isAdmin = User?.IsInRole(PerfisAcesso.UserAdm) ?? false;
}

@section Head {
    <style>
        .org-shell {
            display: grid;
            gap: 18px;
            min-width: 0;
            width: 100%;
            max-width: 100%;
            overflow-x: hidden;
        }

        .org-shell > * {
            min-width: 0;
            max-width: 100%;
        }

        .org-card-surface,
        .org-panel,
        .org-detail,
        .org-admin {
            background: var(--color-surface);
            border-radius: 24px;
            border: 1px solid var(--color-border);
            box-shadow: var(--shadow-sm);
            min-width: 0;
            max-width: 100%;
            overflow: hidden;
        }

        .org-hero {
            padding: 22px;
            display: grid;
            gap: 18px;
        }

        .org-hero__top {
            display: grid;
            grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
            gap: 18px;
            align-items: start;
            min-width: 0;
        }

        .org-hero__title {
            margin: 0;
            color: var(--color-heading);
            font-size: 1.08rem;
        }

        .org-hero__text {
            margin: 8px 0 0;
            max-width: 78ch;
            color: var(--color-text-muted);
            font-size: 0.84rem;
            line-height: 1.7;
        }

        .org-hero__aside {
            padding: 16px;
            border-radius: 18px;
            border: 1px solid rgba(96, 165, 250, 0.14);
            background: linear-gradient(180deg, rgba(239, 246, 255, 0.98), rgba(248, 250, 252, 0.98));
            display: grid;
            gap: 10px;
        }

        .org-hero__aside h3,
        .org-panel__header h2,
        .org-detail__header h2,
        .org-admin__header h2 {
            margin: 0;
            color: var(--color-heading);
            font-size: 0.96rem;
        }

        .org-hero__aside p,
        .org-panel__header p,
        .org-detail__header p,
        .org-admin__header p {
            margin: 0;
            color: var(--color-text-muted);
            font-size: 0.76rem;
            line-height: 1.6;
        }

        .org-stats {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            min-width: 0;
        }

        .org-stat {
            border-radius: 18px;
            padding: 14px 16px;
            border: 1px solid rgba(148, 163, 184, 0.16);
            background: linear-gradient(180deg, rgba(248, 250, 252, 0.98), rgba(255, 255, 255, 1));
            display: grid;
            gap: 6px;
        }

        .org-stat__label {
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: #69809a;
        }

        .org-stat__value {
            color: var(--color-heading);
            font-size: 1.35rem;
            font-weight: 900;
        }

        .org-stat__meta {
            color: var(--color-text-muted);
            font-size: 0.74rem;
            line-height: 1.45;
        }

        .org-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .org-legend__item {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 999px;
            border: 1px solid rgba(148, 163, 184, 0.18);
            background: rgba(255, 255, 255, 0.96);
            color: #5c7088;
            font-size: 0.74rem;
            font-weight: 700;
        }

        .org-legend__swatch {
            width: 12px;
            height: 12px;
            border-radius: 999px;
            border: 1px solid rgba(15, 23, 42, 0.1);
            flex-shrink: 0;
        }

        .org-panel,
        .org-detail,
        .org-admin {
            padding: 18px;
            display: grid;
            gap: 16px;
        }

        .org-panel__header,
        .org-detail__header,
        .org-admin__header {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 16px;
            flex-wrap: wrap;
        }

        .org-panel__header--stack {
            flex-direction: column;
            align-items: stretch;
        }

        .org-panel__header--stack .org-tabs {
            align-self: flex-start;
        }

        .org-tabs {
            display: inline-flex;
            align-items: flex-end;
            border-bottom: 1px solid rgba(148, 163, 184, 0.22);
            flex-wrap: wrap;
            row-gap: 8px;
            max-width: 100%;
        }

        .org-tab {
            border: 1px solid transparent;
            border-bottom: none;
            background: linear-gradient(180deg, rgba(248, 250, 252, 0.92), rgba(241, 245, 249, 0.9));
            color: #5c7392;
            padding: 12px 18px;
            border-radius: 18px 18px 0 0;
            font-size: 0.84rem;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.18s ease;
        }

        .org-tab.is-active {
            color: var(--color-heading);
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.96));
            border-color: rgba(148, 163, 184, 0.24);
            box-shadow: inset 0 -3px 0 #112a46;
        }

        .org-view {
            display: none;
        }

        .org-view.is-active {
            display: block;
        }

        .org-board {
            position: relative;
            overflow: hidden;
            padding-bottom: 8px;
            max-width: 100%;
            zoom: 0.8;
        }

        .org-board__hero {
            position: relative;
            display: block;
            gap: 12px;
            align-items: start;
            margin-bottom: 2px;
            min-height: 0;
        }

        .org-board__hero > div {
            display: none;
        }

        .org-board__legend-box,
        .org-board__foot-card {
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 20px;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.98));
            padding: 12px 14px;
        }

        .org-board__legend-box {
            position: absolute;
            top: 0;
            left: 0;
            width: 250px;
            z-index: 2;
            display: grid;
            gap: 6px;
            align-content: start;
        }

        .org-board__legend-box h3,
        .org-board__foot-card h3 {
            margin: 0;
            color: #153a6b;
            font-size: 0.76rem;
            font-weight: 900;
            text-transform: uppercase;
        }

        .org-board__legend-list {
            display: grid;
            grid-template-columns: 1fr;
            gap: 5px;
        }

        .org-board__legend-line {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #304d72;
            font-size: 0.62rem;
            font-weight: 700;
        }

        .org-board__legend-stroke {
            width: 34px;
            height: 2px;
            border-radius: 999px;
            background: #1f4fb3;
            flex-shrink: 0;
        }

        .org-board__legend-stroke--dashed {
            background: none;
            border-top: 2px dashed #7b3db6;
            height: 0;
        }

        .org-board__svg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            overflow: visible;
            z-index: 0;
        }

        .org-board__rows {
            width: 100%;
            min-width: 0;
            display: grid;
            gap: 64px;
            position: relative;
            z-index: 1;
            padding: 8px 18px 38px;
            margin: 0 auto;
        }

        .org-board__rows > .org-row {
            flex-shrink: 0;
        }

        .org-row {
            display: flex;
            justify-content: center;
            flex-wrap: nowrap;
            gap: 44px 22px;
            position: relative;
            width: 100%;
            margin: 0 auto;
        }

        .org-row--single {
            max-width: 228px;
        }

        .org-row--duo {
            max-width: 470px;
        }

        .org-row--trio {
            max-width: 720px;
            gap: 36px;
        }

        .org-row--directors {
            max-width: 1060px;
            gap: 28px;
        }

        .org-row--supports {
            max-width: 760px;
            gap: 28px;
        }

        .org-row--superintendencias {
            max-width: 860px;
            gap: 30px;
        }

        .org-row--gerencias {
            flex-wrap: wrap;
            justify-content: center;
            gap: 28px 12px;
        }

        .org-row--gerencias-principais {
            max-width: 1220px;
        }

        .org-row--gerencias-planejadas {
            max-width: 860px;
        }

        .org-card {
            min-width: 150px;
            max-width: 182px;
            border: 1px solid rgba(148, 163, 184, 0.24);
            border-radius: 20px;
            padding: 12px 12px 11px;
            display: grid;
            gap: 7px;
            text-align: left;
            cursor: pointer;
            color: #0f172a;
            background: #fff;
            box-shadow: 0 18px 34px rgba(15, 23, 42, 0.08);
            transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, opacity 0.18s ease;
            position: relative;
            overflow: hidden;
        }

        .org-card__topline {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .org-card__topline .org-card__title {
            min-height: 0;
            flex: 1;
            text-align: left;
        }

        .org-card__icon {
            width: 26px;
            height: 26px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            background: rgba(255, 255, 255, 0.18);
            color: currentColor;
        }

        .org-card__icon i {
            font-size: 0.78rem;
        }

        .org-card__icon svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
        }

        .org-card::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 5px;
            background: rgba(255, 255, 255, 0.78);
            opacity: 0.7;
        }

        .org-card:hover,
        .org-mini-card:hover,
        .org-group-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 32px rgba(15, 23, 42, 0.08);
        }

        .org-card.is-active,
        .org-mini-card.is-active,
        .org-group-button.is-active {
            border-color: rgba(37, 99, 235, 0.34);
            box-shadow: 0 18px 36px rgba(37, 99, 235, 0.14);
        }

        .org-card.is-dimmed {
            opacity: 0.3;
            filter: grayscale(1);
        }

        .org-card.is-path {
            opacity: 1;
        }

        .org-card__eyebrow {
            display: none;
            align-items: center;
            gap: 6px;
            font-size: 0.56rem;
            font-weight: 900;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .org-card__title,
        .org-mini-card__title {
            font-size: 0.8rem;
            font-weight: 900;
            line-height: 1.22;
        }

        .org-card__meta,
        .org-mini-card__meta {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            color: #52657f;
            font-size: 0.58rem;
        }

        .org-card__hint {
            color: #475569;
            font-size: 0.62rem;
            line-height: 1.34;
        }

        .org-card__meta .org-pill {
            padding: 4px 7px;
            font-size: 0.52rem;
        }

        .org-card--hero {
            min-width: 214px;
            max-width: 214px;
            min-height: 74px;
            text-align: center;
            justify-items: center;
            padding: 14px 15px 12px;
        }

        .org-card--hero .org-card__topline,
        .org-card--leader .org-card__topline,
        .org-card--regional .org-card__topline,
        .org-card--manager .org-card__topline {
            width: 100%;
        }

        .org-card--hero::before {
            width: 0;
        }

        .org-card--leader {
            min-width: 184px;
            max-width: 184px;
            min-height: 72px;
            justify-items: center;
            text-align: center;
            padding: 13px 14px 12px;
        }

        .org-card--support {
            min-width: 96px;
            max-width: 96px;
            min-height: 30px;
            padding: 8px 10px;
            gap: 4px;
            justify-items: center;
            text-align: center;
        }

        .org-card--support .org-card__eyebrow,
        .org-card--support .org-card__meta,
        .org-card--support .org-card__hint {
            display: none;
        }

        .org-card--support .org-card__icon {
            display: inline-flex;
        }

        .org-card--support .org-card__title {
            font-size: 0.7rem;
            line-height: 1.15;
        }

        .org-card--support .org-card__topline {
            flex-direction: column;
            justify-content: center;
            gap: 4px;
        }

        .org-card--support .org-card__topline .org-card__title {
            flex: none;
            text-align: center;
        }

        .org-card--regional {
            min-width: 150px;
            max-width: 150px;
            min-height: 70px;
            justify-items: center;
            text-align: center;
        }

        .org-card--regional .org-card__title {
            overflow-wrap: anywhere;
        }

        .org-card--manager {
            min-width: 126px;
            max-width: 126px;
            min-height: 88px;
            padding: 9px 8px 8px;
            gap: 6px;
            justify-items: center;
            text-align: center;
        }

        .org-card--manager .org-card__title {
            font-size: 0.62rem;
            line-height: 1.18;
            min-height: 3.54em;
            max-height: 3.54em;
            overflow: hidden;
            overflow-wrap: normal;
            word-break: normal;
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 3;
        }

        .org-card--manager .org-card__hint {
            font-size: 0.52rem;
            line-height: 1.24;
        }

        .org-card--manager .org-card__eyebrow {
            font-size: 0.48rem;
        }

        .org-card--manager .org-card__meta {
            justify-content: center;
            gap: 3px;
            font-size: 0.48rem;
        }

        .org-card--manager .org-pill {
            padding: 4px 7px;
            font-size: 0.52rem;
        }

        .org-pill,
        .org-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 0.68rem;
            font-weight: 800;
        }

        .org-card--governanca {
            background: linear-gradient(180deg, rgba(65, 105, 190, 0.96), rgba(79, 116, 196, 0.96));
            color: #fff;
        }

        .org-card--governanca .org-card__hint,
        .org-card--governanca .org-card__meta,
        .org-card--governanca .org-card__eyebrow,
        .org-card--presidencia .org-card__hint,
        .org-card--presidencia .org-card__meta,
        .org-card--presidencia .org-card__eyebrow {
            color: rgba(255, 255, 255, 0.92);
        }

        .org-card--presidencia {
            background: linear-gradient(180deg, rgba(114, 51, 163, 0.98), rgba(129, 63, 181, 0.98));
            color: #fff;
        }

        .org-card--diretoria {
            background: linear-gradient(180deg, rgba(255, 241, 71, 0.98), rgba(255, 234, 0, 0.96));
            color: #294166;
        }

        .org-card--diretoria::before {
            background: rgba(41, 65, 102, 0.2);
        }

        .org-card--implementada {
            background: linear-gradient(180deg, rgba(11, 188, 92, 0.98), rgba(6, 166, 82, 0.96));
            color: #fff;
        }

        .org-card--planejada {
            background: linear-gradient(180deg, rgba(128, 234, 239, 0.98), rgba(104, 220, 231, 0.96));
            color: #23516e;
        }

        .org-card--planejada::before {
            background: rgba(35, 81, 110, 0.18);
        }

        .org-card--diretoria .org-card__hint,
        .org-card--diretoria .org-card__meta,
        .org-card--planejada .org-card__hint,
        .org-card--planejada .org-card__meta {
            color: rgba(35, 65, 102, 0.88);
        }

        .org-link {
            fill: none;
            stroke: rgba(37, 99, 235, 0.42);
            stroke-width: 2.3;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .org-link--highlight {
            stroke: rgba(29, 78, 216, 0.82);
            stroke-width: 3.1;
        }

        .org-link--dimmed {
            stroke: rgba(100, 116, 139, 0.42);
            opacity: 0.55;
        }

        .org-link--dashed {
            stroke: rgba(123, 61, 182, 0.78);
            stroke-dasharray: 7 5;
        }

        .org-board__foot {
            display: grid;
            grid-template-columns: minmax(220px, 0.24fr) minmax(0, 1fr) minmax(220px, 0.24fr);
            gap: 18px;
            margin-top: 24px;
        }

        .org-board__foot-list {
            margin: 0;
            padding-left: 18px;
            display: grid;
            gap: 6px;
            color: #2f4d73;
            font-size: 0.8rem;
            line-height: 1.5;
        }

        .org-board__criteria {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
        }

        .org-board__criterion {
            display: grid;
            gap: 6px;
            padding: 6px 8px;
        }

        .org-board__criterion strong {
            color: #163a6d;
            font-size: 0.82rem;
        }

        .org-board__criterion span {
            color: #4c6584;
            font-size: 0.76rem;
            line-height: 1.5;
        }

        .org-horizontal {
            display: grid;
            gap: 16px;
        }

        .org-group-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 12px;
        }

        .org-group-button,
        .org-mini-card {
            border: 1px solid rgba(148, 163, 184, 0.22);
            border-radius: 18px;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.98));
            padding: 14px;
            display: grid;
            gap: 8px;
            text-align: left;
            cursor: pointer;
            transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        }

        .org-group-button__title,
        .org-column__title {
            color: var(--color-heading);
            font-size: 0.82rem;
            font-weight: 900;
        }

        .org-group-button__meta,
        .org-column__empty {
            color: var(--color-text-muted);
            font-size: 0.74rem;
            line-height: 1.55;
        }

        .org-breadcrumb {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .org-breadcrumb__item {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 999px;
            background: rgba(239, 246, 255, 0.94);
            color: #1f4d82;
            font-size: 0.72rem;
            font-weight: 800;
        }

        .org-columns {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
        }

        .org-column {
            border: 1px solid rgba(148, 163, 184, 0.16);
            border-radius: 22px;
            background: linear-gradient(180deg, rgba(248, 250, 252, 0.98), rgba(255, 255, 255, 1));
            padding: 16px;
            display: grid;
            align-content: start;
            gap: 12px;
            min-height: 360px;
        }

        .org-column__list,
        .org-detail__children,
        .org-admin__grid {
            display: grid;
            gap: 10px;
        }

        .org-status--implementada {
            background: rgba(220, 252, 231, 0.96);
            color: #167244;
        }

        .org-status--planejada {
            background: rgba(207, 250, 254, 0.96);
            color: #17617a;
        }

        .org-status--institucional {
            background: rgba(239, 246, 255, 0.98);
            color: #1f4d82;
        }

        .org-detail__content {
            display: grid;
            grid-template-columns: minmax(0, 0.86fr) minmax(280px, 0.64fr);
            gap: 16px;
        }

        .org-detail__summary,
        .org-detail__children-box,
        .org-admin__card {
            border-radius: 20px;
            border: 1px solid rgba(148, 163, 184, 0.18);
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.98));
            padding: 16px;
            display: grid;
            gap: 12px;
        }

        .org-detail__summary {
            gap: 16px;
            background: linear-gradient(145deg, #f8fbff 0%, #ffffff 58%, #f2f8ff 100%);
        }

        .org-detail__identity {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            align-items: center;
            gap: 12px;
            padding-bottom: 14px;
            border-bottom: 1px solid rgba(96, 165, 250, 0.18);
        }

        .org-detail__icon {
            width: 46px;
            height: 46px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: linear-gradient(145deg, #1d4ed8, #0ea5e9);
            color: #fff;
            box-shadow: 0 10px 22px rgba(29, 78, 216, 0.2);
        }

        .org-detail__icon i {
            font-size: 1.05rem;
        }

        .org-detail__identity-copy {
            display: grid;
            gap: 4px;
            min-width: 0;
        }

            min-width: 190px;
            max-width: 190px;
            min-height: 78px;

        .org-detail__identity-copy .org-detail__title {
            overflow-wrap: anywhere;
        }

        .org-detail__metrics {
            min-height: 2.44em;
            max-height: 2.44em;
            overflow: hidden;
            overflow-wrap: normal;
            word-break: normal;
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 8px;
        }

        .org-detail__metric {
            display: grid;
            gap: 4px;
            padding: 10px;
            border: 1px solid rgba(148, 163, 184, 0.16);
            border-radius: 13px;
            background: rgba(255, 255, 255, 0.82);
        }

        .org-detail__metric-label {
            color: #66809f;
            font-size: 0.62rem;
            font-weight: 800;
            line-height: 1.2;
            text-transform: uppercase;
        }

        .org-detail__metric-value {
