@using versaoCsharp.Models
@{
    var activeNav = ViewData["ActiveNav"] as string ?? "";
    var isAdmin = User?.IsInRole(PerfisAcesso.UserAdm) ?? false;
    var canOperate = isAdmin || (User?.IsInRole(PerfisAcesso.UserCi) ?? false);
    var canViewFluxoArvore = canOperate || (User?.IsInRole(PerfisAcesso.UserPadrao) ?? false);
    var empresaClaim = (User?.FindFirst("empresa")?.Value ?? string.Empty).Trim().ToUpperInvariant();
    var email = (User?.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? string.Empty).Trim();
    var empresa = empresaClaim;

    if (string.IsNullOrWhiteSpace(empresa) || !EmpresasAcesso.Todas.Contains(empresa))
    {
        empresa = versaoCsharp.Services.AuthService.InferirEmpresaPorEmail(email);
    }

    var logoPath = empresa switch
    {
        "AGEDOCE" => "/static/logo_agedoce.png",
        "AGEGRANDE" => "/static/logo_agegrande.png",
        "AGEGOIAS" => "/static/logo_agegoias.png",
        _ => "/static/logo_agevap.jpeg"
    };
    var logoAlt = empresa switch
    {
        "AGEDOCE" => "Logo AGEDOCE",
        "AGEGRANDE" => "Logo AGEGRANDE",
        "AGEGOIAS" => "Logo AGEGOIAS",
        _ => "Logo AGEVAP"
    };

    string NavClass(string key) => activeNav == key ? "sidebar__nav-link active" : "sidebar__nav-link";
}
<aside class="sidebar">
    <div class="sidebar__topbar">
        <div class="sidebar__logo">
            <a href="https://www.agevap.org.br/" target="_blank" rel="noopener">
                <img src="@logoPath" alt="@logoAlt">
            </a>
        </div>
        <button type="button" class="sidebar__menu-button" id="sidebarToggle" aria-label="Alternar menu" aria-expanded="true">
            <i class="fas fa-chevron-left"></i>
        </button>
    </div>
    <div class="sidebar__brand">
        <div class="sidebar__brand-badge">
            <span class="sidebar__brand-icon" aria-hidden="true">
                <i class="fas fa-shield-halved"></i>
            </span>
            <span class="sidebar__eyebrow">Controle Interno</span>
        </div>
    </div>
    <nav class="sidebar__nav">
        @if (canViewFluxoArvore)
        {
            <div class="sidebar__section-label">Operação</div>
            @if (canOperate)
            {
                <a href="/TELA-LISTA-PROCESSO" class="@NavClass("processos")" title="Processos">
                    <i class="fas fa-folder-tree"></i>
                    <span>Processos</span>
                </a>
                <a href="/TELA-LISTA-CHECKLIST" class="@NavClass("checklists")" title="Checklists">
                    <i class="fas fa-list-check"></i>
                    <span>Checklists</span>
                </a>
            }

            <a href="/FluxoArvore" class="@NavClass("fluxo-arvore")" title="Fluxo Árvore">
                <i class="fas fa-code-branch"></i>
                <span>Fluxo Árvore</span>
            </a>
            @if (isAdmin)
            {
                <a href="/Organograma" class="@NavClass("organograma")" title="Organograma">
                    <i class="fas fa-building-columns"></i>
                    <span>Organograma</span>
                </a>
            }
        }

        <div class="sidebar__section-label">Análise</div>
        <a href="/DASHBOARD-CONF" class="@NavClass("dashboard-conf")" title="Dashboard Análise CI">
            <i class="fas fa-chart-line"></i>
            <span>Dashboard Análise CI</span>
        </a>
        <a href="/DASHBOARD-CRONO" class="@NavClass("dashboard-crono")" title="Dashboard Cronoanálise">
            <i class="fas fa-chart-column"></i>
            <span>Dashboard Cronoanálise</span>
        </a>

        @if (isAdmin)
        {
            <div class="sidebar__section-label">Administração</div>
            <a href="/novo-usuario" class="@NavClass("usuarios")" title="Usuários">
                <i class="fas fa-user-shield"></i>
                <span>Usuários</span>
            </a>
        }

        <div class="sidebar__section-label">Suporte</div>
        <a href="/meu-perfil" class="@NavClass("perfil")" title="Meu Perfil">
            <i class="fas fa-user-gear"></i>
            <span>Meu Perfil</span>
        </a>
        <a href="/GuiaUsuario" class="@NavClass("guia")" title="Guia do Usuário">
            <i class="fas fa-book-open"></i>
            <span>Guia do Usuário</span>
        </a>
        <a href="/logout" class="sidebar__nav-link" title="Sair" id="sidebarLogoutLink">
            <i class="fas fa-arrow-right-from-bracket"></i>
            <span>Sair</span>
        </a>
    </nav>
    <div class="sidebar-footer">
        <p>&copy; 2026 Controle Interno</p>
    </div>
</aside>
<form id="sidebarLogoutForm" action="/logout" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>
