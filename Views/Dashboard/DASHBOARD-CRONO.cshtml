        const p = palette();
        tempoMedioPorFase.sort((a, b) => b.p90 - a.p90);
        const cores = gerarCores(tempoMedioPorFase.length);
        const maiorValor = Math.max(...tempoMedioPorFase.map(fase => Number(fase.p90) || 0), 0);

        const chartDiv = document.querySelector('#tempoMedioFaseChart');
        renderApexChart(chartDiv, {
            chart: {
                type: 'bar',
                width: '100%',
                height: Math.max(360, tempoMedioPorFase.length * 26),
                offsetX: 8,
                toolbar: { show: false },
                events: {
                    dataPointSelection: function (_event, _chartContext, config) {
                        const faseSelecionada = tempoMedioPorFase?.[config.dataPointIndex]?.nome || '';
                        if (!faseSelecionada) return;
                        cronoFilters.fase = faseSelecionada === cronoFilters.fase ? '' : faseSelecionada;
                        carregarDadosDashboard();
                    }
                }
            },
            plotOptions: {
                bar: {
                    horizontal: true,
                    borderRadius: 6,
                    barHeight: '52%',
                    dataLabels: { position: 'top' },
                    distributed: true
                }
            },
            series: [{ name: 'P90 (dias)', data: tempoMedioPorFase.map(fase => Math.round(fase.p90)) }],
            xaxis: {
                categories: tempoMedioPorFase.map(fase => limparNomeFase(fase.nome)),
                min: 0,
                max: Math.ceil(maiorValor * 1.12),
                tickAmount: Math.min(6, Math.max(2, Math.ceil(maiorValor / 20))),
                labels: {
                    formatter: value => formatarNumeroGrafico(value),
                    style: { fontSize: '11px', colors: p.text }
                },
                axisBorder: { show: true, color: p.grid },
                axisTicks: { show: true, color: p.grid }
            },
            yaxis: {
                title: { text: 'Fases' },
                labels: {
                    minWidth: 320,
                    maxWidth: 320,
                    align: 'left',
                    offsetX: 8,
                    style: { fontSize: '9px', colors: [p.text], fontWeight: 600 }
                }
            },
            fill: { type: 'solid', colors: cores },
            colors: cores,
            dataLabels: {
                enabled: true,
                formatter: val => `${formatarNumeroGrafico(val)} dias`,
                offsetX: 10,
                style: { fontSize: '12px', colors: [p.text], fontWeight: 700 },
                textAnchor: 'start'
            },
            tooltip: {
                theme: 'dark',
                y: { formatter: val => `${formatarNumeroGrafico(val)} dias` }
            },
            grid: {
                borderColor: p.grid,
                row: { colors: ['transparent', 'transparent'], opacity: 0.5 },
                padding: { left: 0, right: 14 }
            },
            legend: { show: false }
        });
    };

    carregarGraficoEvolucao = function (dados) {
        try {
            if (!Array.isArray(dados) || dados.length === 0) {
                const chartDiv = document.querySelector('#evolucaoChart');
                if (chartDiv) chartDiv.innerHTML = '<div style="text-align:center;color:#888;padding:40px 0;">Sem dados para exibir</div>';
                return;
            }

            const p = palette();
            const chartDiv = document.querySelector('#evolucaoChart');

            renderApexChart(chartDiv, {
                chart: { type: 'line', height: 276, toolbar: { show: false }, zoom: { enabled: false } },
                series: [
                    { name: 'Lead time médio', data: dados.map(item => Math.round(item.lead_time_medio)) },
                    { name: 'Lead time P90', data: dados.map(item => Math.round(item.lead_time_p90)) }
                ],
                xaxis: {
                    categories: dados.map(item => formatarMesGrafico(item.mes)),
                    labels: { style: { colors: p.text } }
                },
                yaxis: {
                    labels: {
                        formatter: value => formatarNumeroGrafico(value),
                        style: { colors: [p.text] }
                    }
                },
                stroke: { curve: 'smooth', width: 5 },
                colors: [p.blue, p.orange],
                fill: { type: 'gradient', gradient: { shadeIntensity: 0.18, opacityFrom: 0.32, opacityTo: 0.06, stops: [0, 100] } },
                markers: { size: 5, hover: { sizeOffset: 2 } },
                tooltip: {
                    theme: 'dark',
                    shared: true,
                    intersect: false,
                    y: { formatter: val => `${formatarNumeroGrafico(val)} dias` }
                },
                grid: { borderColor: p.grid, strokeDashArray: 4 },
                legend: { position: 'top' },
                noData: { text: 'Sem dados para exibir' }
            });
        } catch (error) {
            console.error('Erro ao renderizar o gráfico de evolução:', error);
        }
    };

    carregarGraficoEvolucaoTempoMedioTotal = function (evolucao) {
        if (!Array.isArray(evolucao) || evolucao.length === 0) {
            const chartDiv = document.querySelector('#evolucaoTempoMedioTotalChart');
            if (chartDiv) chartDiv.innerHTML = '<div style="text-align:center;color:#888;padding:40px 0;">Sem dados para exibir</div>';
            return;
        }

        const p = palette();
        const cores = gerarCores(evolucao.length);
        const chartDiv = document.querySelector('#evolucaoTempoMedioTotalChart');

        renderApexChart(chartDiv, {
            chart: { type: 'bar', height: 248, toolbar: { show: false } },
            series: [{ name: 'Processos concluídos', data: evolucao.map(item => item.total) }],
            xaxis: {
                categories: evolucao.map(item => formatarMesGrafico(item.mes)),
                labels: { style: { fontSize: '13px', colors: p.text } }
            },
            yaxis: {
                labels: {
                    formatter: value => formatarNumeroGrafico(value),
                    style: { colors: [p.text] }
                }
            },
            plotOptions: { bar: { columnWidth: '55%', distributed: true, borderRadius: 6 } },
            colors: cores,
            fill: { type: 'solid', colors: cores },
            tooltip: {
                shared: true,
                intersect: false,
                y: { formatter: val => formatarNumeroGrafico(val) }
            },
            legend: { show: false },
            grid: { borderColor: p.grid }
        });
    };

    carregarGraficoDistribuicaoTempoResumo = function (tempoPorFase) {
        const chartDiv = document.querySelector('#tempoDistribuicaoResumoChart');
        if (!chartDiv) return;

        destroyChart(chartDiv);

        if (!Array.isArray(tempoPorFase) || tempoPorFase.length === 0) {
            chartDiv.innerHTML = '<div style="text-align:center;color:#888;padding:40px 0;">Sem dados para exibir</div>';
            return;
        }

        const distribuicao = tempoPorFase
            .map(fase => {
                const total = Number(fase.total) || 0;
                const count = Number(fase.count) || 0;
                const media = count > 0 ? total / count : 0;
                return { nome: limparNomeFase(fase.nome), media };
            })
            .filter(fase => fase.media > 0)
            .sort((a, b) => b.media - a.media)
            .slice(0, 6);

        if (!distribuicao.length) {
            chartDiv.innerHTML = '<div style="text-align:center;color:#888;padding:40px 0;">Sem dados para exibir</div>';
            return;
        }

        renderApexChart(chartDiv, {
            chart: { type: 'donut', height: 360, toolbar: { show: false } },
            series: distribuicao.map(item => Math.round(item.media)),
            labels: distribuicao.map(item => item.nome),
            colors: gerarCores(distribuicao.length),
            stroke: { width: 0 },
            plotOptions: {
                pie: {
                    offsetX: 0,
                    donut: {
                        size: '58%',
                        labels: {
                            show: true,
                            total: {
                                show: true,
                                label: 'Média total',
                                formatter: function () {
                                    const total = distribuicao.reduce((acc, item) => acc + item.media, 0);
                                    return `${formatarNumeroGrafico(Math.round(total))} dias`;
                                }
                            }
                        }
                    }
                }
            },
            dataLabels: { enabled: false },
            legend: {
                position: 'bottom',
                horizontalAlign: 'center',
                fontSize: '12px',
                offsetX: 0,
                offsetY: 8,
                itemMargin: { vertical: 8, horizontal: 14 },
                markers: { width: 12, height: 12, radius: 12 }
            },
            tooltip: {
                y: {
                    formatter: function (valor, opts) {
                        const item = distribuicao[opts.seriesIndex];
                        return item ? `${item.nome}: ${formatarNumeroGrafico(valor)} dias em média` : `${valor} dias`;
                    }
                }
            },
            responsive: [{
                breakpoint: 1320,
                options: {
                    legend: {
                        position: 'bottom',
                        horizontalAlign: 'center',
                        offsetX: 0,
                        offsetY: 0
                    },
                    plotOptions: {
                        pie: {
                            offsetX: 0
                        }
                    }
                }
            }, {
                breakpoint: 9999,
                options: {
                    legend: {
                        formatter: function (seriesName, opts) {
                            const colunas = 3;
                            const index = opts.seriesIndex;
                            const sufixo = ((index + 1) % colunas === 0) ? '<br />' : '';
                            return `${seriesName}${sufixo}`;
                        }
                    }
                }
            }],
            noData: { text: 'Sem dados para exibir' }
        });

        organizarLegendaDistribuicaoResumo();
    };

    document.addEventListener('DOMContentLoaded', function () {
        const p = palette();
        renderCronoSpark('sparkProcessos', [12, 15, 18, 17, 21, 24, 22], p.blue);
        renderCronoSpark('sparkLead', [34, 31, 29, 30, 27, 24, 22], p.blue);
        renderCronoSpark('sparkP90', [45, 52, 48, 60, 56, 50, 47], p.orange);
        renderCronoSpark('sparkGargalo', [20, 24, 21, 29, 27, 23, 19], p.violet || p.blue);
        renderCronoSpark('sparkMaximo', [52, 58, 55, 67, 63, 61, 59], p.orange);

        const navLinks = Array.from(document.querySelectorAll('[data-dashboard-tab]'));
        const panels = Array.from(document.querySelectorAll('[data-dashboard-panel]'));
        const storageKey = 'dashboard-crono-active-tab';

        function activateTab(tabId) {
            navLinks.forEach(link => {
                const isActive = link.getAttribute('data-dashboard-tab') === tabId;
                link.classList.toggle('is-active', isActive);
                link.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });

            panels.forEach(panel => {
                const isActive = panel.getAttribute('data-dashboard-panel') === tabId;
                panel.classList.toggle('is-active', isActive);
                panel.hidden = !isActive;
            });

            try {
                window.localStorage.setItem(storageKey, tabId);
            } catch (_error) {
            }
        }

        navLinks.forEach(link => {
            link.addEventListener('click', function () {
                const targetId = this.getAttribute('data-dashboard-tab');
                if (targetId) {
                    activateTab(targetId);
                }
            });
        });

        let initialTab = navLinks[0]?.getAttribute('data-dashboard-tab');
        try {
            const savedTab = window.localStorage.getItem(storageKey);
            if (savedTab && panels.some(panel => panel.getAttribute('data-dashboard-panel') === savedTab)) {
                initialTab = savedTab;
            }
        } catch (_error) {
        }

        if (initialTab) {
            activateTab(initialTab);
        }
    });
    </script>
}

