@{
    Layout = "~/Views/Shared/_InternalLayout.cshtml";
    ViewData["Title"] = "Dashboard Cronoanálise";
    ViewData["PageDescription"] = "Análise temporal, desempenho dos processos e composição das fases.";
    ViewData["ActiveNav"] = "dashboard-crono";
}

@section Head {
    <link rel="stylesheet" href="/static/style_dashboard.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <style>
        .info-tip {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 1px solid #cbd5f5;
            color: #1d4ed8;
            font-weight: 700;
            font-size: 12px;
            cursor: help;
            background: #eef2ff;
        }
    </style>
}

<section class="dashboard-shell dashboard-crono">
    <header class="page-header">
        <div>
            <h1 class="page-header__title">Dashboard Cronoanálise</h1>
            <p class="page-header__subtitle">Análise temporal, desempenho dos processos e composição das fases.</p>
            <div class="page-header__meta">
                <span class="stat-badge">Lead time</span>
                <span class="stat-badge">Leitura executiva</span>
                <span class="stat-badge stat-badge--warning">Gargalos prioritários</span>
            </div>
        </div>
    </header>

    <nav class="dashboard-section-nav" aria-label="Navegação do dashboard" role="tablist">
        <button type="button" class="dashboard-section-nav__link is-active" data-dashboard-tab="bloco-crono-resumo" role="tab" aria-selected="true">Resumo Executivo</button>
        <button type="button" class="dashboard-section-nav__link" data-dashboard-tab="bloco-crono-diagnostico" role="tab" aria-selected="false">Diagnóstico de Gargalos</button>
    </nav>

    <section class="dashboard-inline-filters">
        <div class="content-card__header">
            <div>
                <h2 class="content-card__title">Filtros analíticos</h2>
                <p class="content-card__subtitle">Cruze tempo, gargalos e volume por competência, área e modalidade.</p>
            </div>
        </div>
        <div class="content-card__body">
            <div class="dashboard-filters dashboard-filters--reference">
                    <div class="dashboard-filter">
                    <label class="dashboard-filter__label" for="cronoArea">Área</label>
                    <select id="cronoArea" class="dashboard-filter__control">
                        <option value="">Todas</option>
                    </select>
                </div>
                <div class="dashboard-filter">
                    <label class="dashboard-filter__label" for="cronoModalidade">Modalidade</label>
                    <select id="cronoModalidade" class="dashboard-filter__control">
                        <option value="">Todas</option>
                    </select>
                </div>
                <div class="dashboard-filter">
                    <label class="dashboard-filter__label" for="cronoDataInicio">Período inicial</label>
                    <input id="cronoDataInicio" type="date" class="dashboard-filter__control" />
                </div>
                <div class="dashboard-filter">
                    <label class="dashboard-filter__label" for="cronoDataFim">Período final</label>
                    <input id="cronoDataFim" type="date" class="dashboard-filter__control" />
                </div>
                <div class="dashboard-filter dashboard-filter--actions">
                    <span class="dashboard-filter__label">Ações</span>
                    <div class="dashboard-filter__actions">
                        <button type="button" class="dashboard-filter__button" id="cronoLimparFiltros">Limpar</button>
                        <button type="button" class="dashboard-filter__button dashboard-filter__button--primary" id="cronoAplicarFiltros">Aplicar</button>
                    </div>
                </div>
            </div>
            <div class="dashboard-filter__hint" id="cronoFiltroResumo">Sem filtros aplicados.</div>
            <div class="dashboard-filter__active" id="cronoFiltrosAtivos"></div>
        </div>
    </section>


    <section class="dashboard-block is-active" id="bloco-crono-resumo" data-dashboard-panel="bloco-crono-resumo" role="tabpanel">
        <header class="dashboard-block__header">
            <div>
                <h2 class="dashboard-block__title">Resumo Executivo</h2>
                <p class="dashboard-block__subtitle">Leitura rápida do período, comportamento do lead time e sinais mais relevantes da operação.</p>
            </div>
        </header>

        <section class="content-card">
            <div class="content-card__header">
                <div>
                    <h2 class="content-card__title">Resumo cronológico</h2>
                    <p class="content-card__subtitle">Indicadores consolidados do comportamento temporal dos processos avaliados.</p>
                </div>
            </div>
            <div class="content-card__body">
                <section class="dashboard-overview-grid">
                    <div class="dashboard-metrics dashboard-metrics--reference">
                        <article class="metric-card">
                            <span class="metric-card__title">Processos analisados</span>
                            <span class="metric-card__value" id="totalProcessos">Carregando...</span>
                            <span class="metric-card__meta">Base consolidada do período filtrado</span>
                        </article>
                        <article class="metric-card">
                            <span class="metric-card__title">Tempo médio de processo</span>
                            <span class="metric-card__value" id="leadTimeMedio">Carregando...</span>
                            <span class="metric-card__meta">Ritmo médio da operação</span>
                        </article>
                        <article class="metric-card metric-card--warning-soft">
                            <span class="metric-card__title">Tempo alto de processo (P90)</span>
                            <span class="metric-card__value" id="leadTimeP90">Carregando...</span>
                            <span class="metric-card__meta">Casos mais lentos do conjunto</span>
                        </article>
                        <article class="metric-card metric-card--danger-soft">
                            <span class="metric-card__title">Fase gargalo (P90)</span>
                            <span class="metric-card__value" id="faseGargalo">Carregando...</span>
                            <span class="metric-card__meta">Etapa com maior pressão de tempo</span>
                        </article>
                    </div>

                    <aside class="dashboard-insights-card">
                        <div class="dashboard-insights-card__header">
                            <h2>Leitura executiva</h2>
                        </div>
                        <div class="dashboard-insights-card__body">
                            <div class="dashboard-insight-item dashboard-insight-item--accent">
                                <span class="dashboard-insight-item__dot"></span>
                                <div>
                                    <strong>Lead time médio</strong>
                                    <p>Mostra o comportamento normal da operação no período selecionado.</p>
                                </div>
                            </div>
                            <div class="dashboard-insight-item dashboard-insight-item--warning">
                                <span class="dashboard-insight-item__dot"></span>
                                <div>
                                    <strong>P90 de tempo</strong>
                                    <p>Expõe os processos mais lentos e ajuda a localizar atrasos relevantes.</p>
                                </div>
                            </div>
                            <div class="dashboard-insight-item dashboard-insight-item--danger">
                                <span class="dashboard-insight-item__dot"></span>
                                <div>
                                    <strong>Fase gargalo</strong>
                                    <p>Aponta onde priorizar análise e ação corretiva.</p>
                                </div>
                            </div>
                            <div class="dashboard-insight-link">
                                <span>Leitura rápida</span>
                                <small>Se a média cair e o P90 subir, poucos processos estão travando muito.</small>
                            </div>
                        </div>
                    </aside>
                </section>
            </div>
        </section>

        <section class="content-card">
            <div class="content-card__header">
                <div>
                    <h2 class="content-card__title">Evolução e comparativos</h2>
                    <p class="content-card__subtitle">Acompanhe a evolução do tempo e compare o desempenho entre as fases.</p>
                </div>
            </div>
            <div class="content-card__body">
                <div class="chart-grid chart-grid--executive-crono">
                    <article class="chart-panel chart-panel--wide">
                        <div class="chart-panel__header chart-panel__header--light">
                            <div>
                                <h3 class="chart-panel__title">Evolução do tempo do processo</h3>
                                <p class="chart-panel__subtitle">Lead time total e leitura mensal do comportamento dos processos.</p>
                            </div>
                        </div>
                        <div class="chart-panel__body">
                            <div id="evolucaoChart" class="chart-panel__canvas chart-container"></div>
                        </div>
                    </article>
                    <article class="chart-panel chart-panel--sixty">
                        <div class="chart-panel__header chart-panel__header--light">
                            <div>
                                <h3 class="chart-panel__title">Distribuição do tempo por fase</h3>
                                <p class="chart-panel__subtitle">Peso relativo das fases no tempo médio consolidado do período.</p>
                            </div>
                        </div>
                        <div class="chart-panel__body">
                            <div id="tempoMedioFaseChart" class="chart-panel__canvas chart-container"></div>
                        </div>
                    </article>
                    <article class="chart-panel chart-panel--forty">
                        <div class="chart-panel__header chart-panel__header--light">
                            <div>
                                <h3 class="chart-panel__title">Tempo alto por fase (P90)</h3>
                                <p class="chart-panel__subtitle">Fases com maior concentração de atrasos extremos.</p>
                            </div>
                        </div>
                        <div class="chart-panel__body">
                            <div id="tempoDistribuicaoResumoChart" class="chart-panel__canvas chart-container"></div>
                        </div>
                    </article>
                </div>
            </div>
        </section>
    </section>

    <section class="dashboard-block" id="bloco-crono-diagnostico" data-dashboard-panel="bloco-crono-diagnostico" role="tabpanel" hidden>
        <header class="dashboard-block__header">
            <div>
                <h2 class="dashboard-block__title">Diagnóstico de Gargalos</h2>
                <p class="dashboard-block__subtitle">Camada analítica para localizar pressão por fase, composição do tempo e impacto do volume mensal.</p>
            </div>
        </header>

        <section class="content-card">
            <div class="content-card__header">
                <div>
                    <h2 class="content-card__title">Composição das fases</h2>
                    <p class="content-card__subtitle">Tempo médio por fase, volume de processos e leitura de gargalos ao longo dos meses.</p>
                </div>
            </div>
            <div class="content-card__body">
                <div class="chart-grid chart-grid--composition">
                    <article class="chart-panel">
                        <div class="chart-panel__header chart-panel__header--light">
                            <div>
                                <h3 class="chart-panel__title">Tempo médio por fase</h3>
                                <p class="chart-panel__subtitle">Mostra onde o processo consome mais dias em média.</p>
                            </div>
                        </div>
                        <div class="chart-panel__body">
                            <div id="totalDiasPorFaseChart" class="chart-panel__canvas chart-container"></div>
                        </div>
                    </article>
                    <article class="chart-panel">
                        <div class="chart-panel__header chart-panel__header--light">
                            <div>
                                <h3 class="chart-panel__title">Volume de processos por mês</h3>
                                <p class="chart-panel__subtitle">Ajuda a relacionar carga mensal e variação do tempo.</p>
                            </div>
                        </div>
                        <div class="chart-panel__body">
                            <div id="evolucaoTempoMedioTotalChart" class="chart-panel__canvas chart-container"></div>
                        </div>
                    </article>
                </div>
            </div>
        </section>
    </section>
</section>

@section Scripts {
    <script>
    let cronoRequestId = 0;

    const cronoFilters = {
        area: '',
        modalidade: '',
        dataInicio: '',
        dataFim: '',
        fase: ''
    };

    function buildCronoFilterQuery() {
        const params = new URLSearchParams();
        Object.entries(cronoFilters).forEach(([key, value]) => {
            if (value) {
                params.set(key, value);
            }
        });
        const query = params.toString();
        return query ? `?${query}` : '';
    }

    function hydrateCronoFiltersFromUrl() {
        const params = new URLSearchParams(window.location.search);
        cronoFilters.area = params.get('area') || '';
        cronoFilters.modalidade = params.get('modalidade') || '';
        cronoFilters.dataInicio = params.get('dataInicio') || '';
        cronoFilters.dataFim = params.get('dataFim') || '';
        cronoFilters.fase = params.get('fase') || '';
    }

    function syncCronoFiltersToInputs() {
        const map = {
            cronoArea: cronoFilters.area,
            cronoModalidade: cronoFilters.modalidade,
            cronoDataInicio: cronoFilters.dataInicio,
            cronoDataFim: cronoFilters.dataFim
        };
        Object.entries(map).forEach(([id, value]) => {
            const el = document.getElementById(id);
            if (el) el.value = value;
        });
    }

    function syncInputsToCronoFilters() {
        cronoFilters.area = document.getElementById('cronoArea')?.value || '';
        cronoFilters.modalidade = document.getElementById('cronoModalidade')?.value || '';
        cronoFilters.dataInicio = document.getElementById('cronoDataInicio')?.value || '';
        cronoFilters.dataFim = document.getElementById('cronoDataFim')?.value || '';
    }

    function persistCronoFiltersInUrl() {
        const params = new URLSearchParams();
        Object.entries(cronoFilters).forEach(([key, value]) => {
            if (value) params.set(key, value);
        });
        const nextUrl = `${window.location.pathname}${params.toString() ? `?${params.toString()}` : ''}`;
        window.history.replaceState({}, '', nextUrl);
    }

    async function fetchCronoJson(url) {
        const response = await fetch(url);
        if (!response.ok) throw new Error(`Falha ao buscar ${url}`);
        return response.json();
    }

    function preencherSelectCrono(id, values, defaultLabel) {
        const select = document.getElementById(id);
        if (!select) return;
        const atual = select.value;
        select.innerHTML = `<option value="">${defaultLabel}</option>` +
            values.map(value => `<option value="${value}">${value}</option>`).join('');
        select.value = values.includes(atual) ? atual : '';
    }

    function atualizarResumoFiltrosCrono() {
        const partes = [];
        if (cronoFilters.area) partes.push(`Área: ${cronoFilters.area}`);
        if (cronoFilters.modalidade) partes.push(`Modalidade: ${cronoFilters.modalidade}`);
        if (cronoFilters.dataInicio || cronoFilters.dataFim) {
            partes.push(`Período: ${cronoFilters.dataInicio || '...'} até ${cronoFilters.dataFim || '...'}`);
        }
        if (cronoFilters.fase) partes.push(`Fase: ${cronoFilters.fase}`);
        const resumo = document.getElementById('cronoFiltroResumo');
        if (resumo) {
            resumo.textContent = partes.length ? partes.join(' • ') : 'Sem filtros aplicados.';
            resumo.style.display = partes.length ? 'block' : 'none';
        }
    }

    function renderCronoActiveFilterChips() {
        const container = document.getElementById('cronoFiltrosAtivos');
        if (!container) return;

        const chips = [];
        if (cronoFilters.area) chips.push({ key: 'area', label: `Área: ${cronoFilters.area}` });
        if (cronoFilters.modalidade) chips.push({ key: 'modalidade', label: `Modalidade: ${cronoFilters.modalidade}` });
        if (cronoFilters.dataInicio || cronoFilters.dataFim) chips.push({ key: 'periodo', label: `Período: ${cronoFilters.dataInicio || '...'} até ${cronoFilters.dataFim || '...'}` });
        if (cronoFilters.fase) chips.push({ key: 'fase', label: `Fase: ${cronoFilters.fase}` });

        container.innerHTML = chips.map(chip => `
            <span class="dashboard-filter__chip">
                ${chip.label}
                <button type="button" data-remove-crono-filter="${chip.key}" aria-label="Remover filtro">&times;</button>
            </span>
        `).join('');

        container.querySelectorAll('[data-remove-crono-filter]').forEach(button => {
            button.addEventListener('click', function () {
                const key = this.getAttribute('data-remove-crono-filter');
                if (key === 'periodo') {
                    cronoFilters.dataInicio = '';
                    cronoFilters.dataFim = '';
                    const inicio = document.getElementById('cronoDataInicio');
                    const fim = document.getElementById('cronoDataFim');
                    if (inicio) inicio.value = '';
                    if (fim) fim.value = '';
                } else if (key) {
                    cronoFilters[key] = '';
                    const map = {
                        area: 'cronoArea',
                        modalidade: 'cronoModalidade'
                    };
                    const inputId = map[key];
                    if (inputId) {
                        const input = document.getElementById(inputId);
                        if (input) input.value = '';
                    }
                }
                carregarDadosDashboard();
            });
        });
    }

    async function carregarFiltrosCrono() {
        const data = await fetchCronoJson('/api/dashboard/filtros');
        preencherSelectCrono('cronoArea', data.areas || [], 'Todas');
        preencherSelectCrono('cronoModalidade', data.modalidades || [], 'Todas');
    }

    document.addEventListener('DOMContentLoaded', async function() {
      ensureCronoVisualShells();
      hydrateCronoFiltersFromUrl();
      await carregarFiltrosCrono();
      syncCronoFiltersToInputs();
      document.getElementById('cronoAplicarFiltros')?.addEventListener('click', function () {
          syncInputsToCronoFilters();
          carregarDadosDashboard();
      });
      ['cronoArea', 'cronoModalidade', 'cronoDataInicio', 'cronoDataFim'].forEach(id => {
          document.getElementById(id)?.addEventListener('change', function () {
              syncInputsToCronoFilters();
              carregarDadosDashboard();
          });
      });
      document.getElementById('cronoLimparFiltros')?.addEventListener('click', function () {
          ['cronoArea', 'cronoModalidade', 'cronoDataInicio', 'cronoDataFim'].forEach(id => {
              const el = document.getElementById(id);
              if (el) el.value = '';
          });
          cronoFilters.area = '';
          cronoFilters.modalidade = '';
          cronoFilters.dataInicio = '';
          cronoFilters.dataFim = '';
          cronoFilters.fase = '';
          carregarDadosDashboard();
      });
      atualizarResumoFiltrosCrono();
      carregarDadosDashboard();
    });

    function enhanceCronoMetricCards() {
        const cards = Array.from(document.querySelectorAll('.dashboard-metrics .metric-card'));
        const configs = [
            { cls: 'metric-card--spark metric-card--violet', icon: 'fa-folder-tree', sparkId: 'sparkProcessos', footer: 'Base acompanhada' },
            { cls: 'metric-card--spark metric-card--cyan', icon: 'fa-timeline', sparkId: 'sparkLead', footer: 'Tempo médio' },
            { cls: 'metric-card--spark metric-card--indigo', icon: 'fa-bolt', sparkId: 'sparkP90', footer: 'Picos operacionais' },
            { cls: 'metric-card--spark metric-card--slim', icon: 'fa-route', sparkId: 'sparkGargalo', footer: 'Fase crítica' }
        ];

        cards.forEach((card, index) => {
            const title = card.querySelector('.metric-card__title');
            const value = card.querySelector('.metric-card__value');
            if (!title || !value || card.querySelector('.metric-card__header')) {
                return;
            }

            const config = configs[index];
            if (!config) {
                return;
            }
            card.className = `metric-card ${config.cls}`;
            title.insertAdjacentHTML('beforebegin', `<div class="metric-card__header"></div>`);
            const header = card.querySelector('.metric-card__header');
            header.appendChild(title);
            header.insertAdjacentHTML('beforeend', `<span class="metric-card__chip"><i class="fas ${config.icon}"></i></span>`);
            value.insertAdjacentHTML('afterend', `<div id="${config.sparkId}" class="metric-card__spark"></div><span class="metric-card__footer">${config.footer}</span>`);
        });
    }

    function ensureCronoVisualShells() {
        const metrics = document.querySelector('.dashboard-metrics--reference');
        if (metrics && !document.getElementById('maiorTempoRegistrado')) {
            metrics.insertAdjacentHTML('beforeend', `
                <article class="metric-card metric-card--success-soft">
                    <span class="metric-card__title">Maior tempo registrado</span>
                    <span class="metric-card__value" id="maiorTempoRegistrado">Carregando...</span>
                    <span class="metric-card__meta">Maior duração identificada no recorte</span>
                </article>
            `);
        }

        const resumoCard = document.querySelector('#bloco-crono-resumo .content-card');
        if (resumoCard && !document.querySelector('.dashboard-insight-strip')) {
            resumoCard.insertAdjacentHTML('afterend', `
                <section class="content-card content-card--strip">
                    <div class="dashboard-insight-strip">
                        <article class="dashboard-insight-strip__item dashboard-insight-strip__item--danger">
                            <span class="dashboard-insight-strip__icon"><i class="fas fa-bullseye"></i></span>
                            <div>
                                <strong id="cronoInsightP90Titulo">Carregando...</strong>
                                <p id="cronoInsightP90Texto">Aguardando dados do período.</p>
                            </div>
                        </article>
                        <article class="dashboard-insight-strip__item dashboard-insight-strip__item--warning">
                            <span class="dashboard-insight-strip__icon"><i class="fas fa-clock"></i></span>
                            <div>
                                <strong id="cronoInsightMediaTitulo">Carregando...</strong>
                                <p id="cronoInsightMediaTexto">Aguardando consolidação da média.</p>
                            </div>
                        </article>
                        <article class="dashboard-insight-strip__item dashboard-insight-strip__item--accent">
                            <span class="dashboard-insight-strip__icon"><i class="fas fa-diagram-project"></i></span>
                            <div>
                                <strong id="cronoInsightFaseTitulo">Carregando...</strong>
                                <p id="cronoInsightFaseTexto">Aguardando leitura das fases.</p>
                            </div>
                        </article>
                        <article class="dashboard-insight-strip__item dashboard-insight-strip__item--success">
                            <span class="dashboard-insight-strip__icon"><i class="fas fa-chart-line"></i></span>
                            <div>
                                <strong id="cronoInsightVolumeTitulo">Carregando...</strong>
                                <p id="cronoInsightVolumeTexto">Aguardando leitura do volume.</p>
                            </div>
                        </article>
                    </div>
                </section>
            `);
        }

        const diagnosticoCard = document.querySelector('#bloco-crono-diagnostico .content-card');
        if (diagnosticoCard && !document.getElementById('tempoPorAreaChart')) {
            diagnosticoCard.insertAdjacentHTML('afterend', `
                <section class="dashboard-bottom-grid">
                    <article class="chart-panel">
                        <div class="chart-panel__header chart-panel__header--light">
                            <div>
                                <h3 class="chart-panel__title">Tempo por Área (média)</h3>
                                <p class="chart-panel__subtitle">Média de dias por Área responsável no recorte atual.</p>
                            </div>
                        </div>
                        <div class="chart-panel__body">
                            <div id="tempoPorAreaChart" class="chart-panel__canvas chart-container"></div>
                        </div>
                    </article>
                    <article class="content-card dashboard-summary-card">
                        <div class="content-card__header">
                            <div>
                                <h2 class="content-card__title">Resumo do desempenho</h2>
                                <p class="content-card__subtitle">Leitura sintética dos principais indicadores de tempo.</p>
                            </div>
                        </div>
                        <div class="content-card__body">
                            <div class="dashboard-summary-list" id="cronoResumoDesempenho"></div>
                        </div>
                    </article>
                </section>
            `);
        }
    }

    function renderCronoSpark(targetId, series, color) {
        const target = document.getElementById(targetId);
        if (!target) {
            return;
        }

        destroyChart(target);
        target.innerHTML = '';

        renderApexChart(target, {
            chart: {
                type: 'area',
                height: 58,
                sparkline: { enabled: true },
                toolbar: { show: false }
            },
            series: [{ data: series }],
            colors: [color],
            stroke: { curve: 'smooth', width: 3 },
            fill: {
                type: 'gradient',
                gradient: { shadeIntensity: 0.35, opacityFrom: 0.55, opacityTo: 0.08, stops: [0, 100] }
            },
            tooltip: { enabled: false },
            dataLabels: { enabled: false }
        });
    }

    const MAPA_FASES_CRONO = {
        aberturadoprocesso: 'Abertura do Processo',
        etapaspreliminares: 'Etapas preliminares',
        consultaaopatrimonio: 'Consulta ao patrimonio',
        elaboracaodotdr: 'Elaboracao do TdR',
        formacaodoprecoreferencia: 'Formacao do preco de referencia',
        dotacaoorcamentaria: 'Dotacao Orcamentaria',
        elaboracaodaminutadoedital: 'Elaboracao da Minuta do Edital',
        analisejuridicadafaseinternadopedidodecotacaodispensa: 'Analise Juridica da fase interna do pedido de cotacao / Dispensa',
        analisejuridicadocertameoupedidodecotacao: 'Analise Juridica do certame ou pedido de cotacao',
        controleinternochecklist1: 'Controle Interno - Checklist 1',
        atoconvocatoriooupedidodecotacao: 'Ato Convocatorio ou pedido de cotacao',
        atoconvocatorio: 'Ato Convocatorio',
        avisodeselecaodepropostas: 'Aviso de Selecao de Propostas',
        documentacaodocertame: 'Documentacao do Certame',
        respostadocontroleinterno: 'Resposta do Controle Interno'
    };

    function normalizarChaveFase(nome) {
        if (!nome) return '';

        return String(nome)
            .replace(/\s*-\s*item(?:ns?)?.*$/i, '')
            .replace(/\s*-\s*itens?.*$/i, '')
            .replace(/\s*-\s*\d+(?:[\.,]\d+)?\s*dias?$/i, '')
            .replace(/checklist\s*1/gi, 'checklist1')
            .replace(/tdr/gi, 'tdr')
            .replace(/patrim[^a-z0-9]*nio/gi, 'patrimonio')
            .replace(/jur[^a-z0-9]*dica/gi, 'juridica')
            .replace(/convocat[^a-z0-9]*rio/gi, 'convocatorio')
            .replace(/sele[^a-z0-9]*o/gi, 'selecao')
            .replace(/documenta[^a-z0-9]*o/gi, 'documentacao')
            .replace(/elabora[^a-z0-9]*o/gi, 'elaboracao')
            .replace(/forma[^a-z0-9]*o/gi, 'formacao')
            .replace(/pre[^a-z0-9]*o/gi, 'preco')
            .replace(/refer[^a-z0-9]*ncia/gi, 'referencia')
            .replace(/dota[^a-z0-9]*o/gi, 'dotacao')
            .replace(/or[^a-z0-9]*ament[^a-z0-9]*ria/gi, 'orcamentaria')
            .replace(/an[^a-z0-9]*lise/gi, 'analise')
            .replace(/cota[^a-z0-9]*o/gi, 'cotacao')
            .replace(/minuta/gi, 'minuta')
            .replace(/controle\s+interno/gi, 'controleinterno')
            .replace(/resposta\s+do\s+controle\s+interno/gi, 'respostadocontroleinterno')
            .replace(/[^a-zA-Z0-9]+/g, '')
            .toLowerCase()
            .trim();
    }

    function limparNomeFase(nome) {
        if (!nome) return '';
        const chave = normalizarChaveFase(nome);
        return MAPA_FASES_CRONO[chave] || String(nome)
            .replace(/\s*-\s*item(?:ns?)?.*$/i, '')
            .replace(/\s*-\s*itens?.*$/i, '')
            .replace(/\s*-\s*\d+(?:[\.,]\d+)?\s*dias?$/i, '')
            .replace(/\s{2,}/g, ' ')
            .trim();
    }

    function destroyChart(target) {
        if (target && target.__apexChartInstance) {
            try {
                target.__apexChartInstance.destroy();
            } catch (_error) {
            }
            target.__apexChartInstance = null;
        }
    }

    function renderApexChart(target, options) {
        if (!target) return null;
        destroyChart(target);
        target.innerHTML = '';
        const chart = new ApexCharts(target, options);
        target.__apexChartInstance = chart;
        chart.render();
        return chart;
    }

    function formatarMesGrafico(valor) {
        if (!valor) return '';
        const partes = String(valor).split('-');
        if (partes.length < 2) return String(valor);

        const ano = partes[0];
        const mes = Number(partes[1]);
        const meses = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];

        if (!Number.isFinite(mes) || mes < 1 || mes > 12) return String(valor);
        return `${meses[mes - 1]}/${String(ano).slice(-2)}`;
    }

    function formatarNumeroGrafico(valor, casas = 0) {
        const numero = Number(valor);
        if (!Number.isFinite(numero)) return '0';
        return numero.toLocaleString('pt-BR', {
            minimumFractionDigits: casas,
            maximumFractionDigits: casas
        });
    }

