    async function carregarDadosDashboard() {
        const requestId = ++cronoRequestId;
        try {
            persistCronoFiltersInUrl();
            atualizarResumoFiltrosCrono();
            renderCronoActiveFilterChips();
            const response = await fetch(`/api/dashboard/geral${buildCronoFilterQuery()}`);
            if (!response.ok) throw new Error('Falha ao buscar dados do dashboard');

            const data = await response.json();
            if (requestId !== cronoRequestId) return;
            const totalProcessos = typeof data.total_processos === 'number' && !isNaN(data.total_processos) ? data.total_processos : 0;
            const leadTimeMedio = typeof data.lead_time_medio === 'number' && !isNaN(data.lead_time_medio) ? Math.round(data.lead_time_medio) : 0;
            const leadTimeP90 = typeof data.lead_time_p90 === 'number' && !isNaN(data.lead_time_p90) ? Math.round(data.lead_time_p90) : 0;
            const maiorTempoRegistrado = typeof data.maior_tempo_registrado === 'number' && !isNaN(data.maior_tempo_registrado) ? Math.round(data.maior_tempo_registrado) : 0;

            document.getElementById('totalProcessos').textContent = totalProcessos.toString();
            document.getElementById('leadTimeMedio').textContent = `${leadTimeMedio} dias`;
            document.getElementById('leadTimeP90').textContent = `${leadTimeP90} dias`;
            document.getElementById('faseGargalo').textContent = data.fase_gargalo ? limparNomeFase(data.fase_gargalo) : 'N/A';
            const maiorTempoEl = document.getElementById('maiorTempoRegistrado');
            if (maiorTempoEl) maiorTempoEl.textContent = `${maiorTempoRegistrado} dias`;

            if (Array.isArray(data.tempo_por_fase) && data.tempo_por_fase.length > 0) {
                carregarGraficoTempoMedioFase(data.tempo_por_fase);
                carregarGraficoTempoMedioFasePizza(data.tempo_por_fase);
                carregarGraficoDistribuicaoTempoResumo(data.tempo_por_fase);
            }
            if (Array.isArray(data.evolucao) && data.evolucao.length > 0) {
                carregarGraficoEvolucao(data.evolucao);
                carregarGraficoEvolucaoTempoMedioTotal(data.evolucao);
            }
            renderCronoInsightStrip(data, totalProcessos, leadTimeMedio, leadTimeP90, maiorTempoRegistrado);
            renderTempoPorArea(data.tempo_por_area || []);
            renderCronoResumoDesempenho(data, leadTimeMedio, leadTimeP90, maiorTempoRegistrado);
        } catch (error) {
            if (requestId !== cronoRequestId) return;
            console.error('Erro ao carregar dados do dashboard:', error);
            document.getElementById('totalProcessos').textContent = '0';
            document.getElementById('leadTimeMedio').textContent = '0 dias';
            document.getElementById('leadTimeP90').textContent = '0 dias';
            document.getElementById('faseGargalo').textContent = 'N/A';
            const maiorTempoEl = document.getElementById('maiorTempoRegistrado');
            if (maiorTempoEl) maiorTempoEl.textContent = '0 dias';
        }
    }

    function setCronoText(id, value) {
        const el = document.getElementById(id);
        if (el) el.textContent = value;
    }

    function renderCronoInsightStrip(data, totalProcessos, leadTimeMedio, leadTimeP90, maiorTempoRegistrado) {
        setCronoText('cronoInsightP90Titulo', `P90 em ${leadTimeP90} dias`);
        setCronoText('cronoInsightP90Texto', `10% dos processos levam mais de ${leadTimeP90} dias para concluir.`);
        setCronoText('cronoInsightMediaTitulo', `Média atual: ${leadTimeMedio} dias`);
        setCronoText('cronoInsightMediaTexto', `${totalProcessos} processos compõem a leitura média do recorte atual.`);
        setCronoText('cronoInsightFaseTitulo', data.fase_gargalo ? limparNomeFase(data.fase_gargalo) : 'Sem fase crítica');
        setCronoText('cronoInsightFaseTexto', data.fase_gargalo ? 'Essa fase concentra o maior impacto no tempo extremo (P90).' : 'Não foi possível identificar gargalo no período.');
        const ultimoVolume = Array.isArray(data.evolucao) && data.evolucao.length ? (data.evolucao[data.evolucao.length - 1]?.total || 0) : 0;
        setCronoText('cronoInsightVolumeTitulo', `Maior tempo: ${maiorTempoRegistrado} dias`);
        setCronoText('cronoInsightVolumeTexto', `${ultimoVolume} processos concluídos no último mês visível da série.`);
    }

    function renderTempoPorArea(dados) {
        const target = document.getElementById('tempoPorAreaChart');
        if (!target) return;
        destroyChart(target);
        target.innerHTML = '';

        if (!Array.isArray(dados) || !dados.length) {
            target.innerHTML = '<div style="text-align:center;color:#888;padding:40px 0;">Sem dados para exibir</div>';
            return;
        }

        const top = [...dados].sort((a, b) => (b.media || 0) - (a.media || 0)).slice(0, 6);
        renderApexChart(target, {
            chart: { type: 'bar', height: 280, toolbar: { show: false } },
            series: [{ name: 'Média (dias)', data: top.map(item => Math.round(item.media || 0)) }],
            plotOptions: { bar: { horizontal: true, borderRadius: 6, distributed: true } },
            colors: gerarCores(top.length),
            xaxis: { categories: top.map(item => item.nome || 'Sem Área') },
            dataLabels: { enabled: true, formatter: val => `${val} dias` },
            legend: { show: false },
            grid: { borderColor: '#e5e7eb' }
        });
    }

    function renderCronoResumoDesempenho(data, leadTimeMedio, leadTimeP90, maiorTempoRegistrado) {
        const container = document.getElementById('cronoResumoDesempenho');
        if (!container) return;
        const processos = typeof data.total_processos === 'number' ? data.total_processos : 0;
        const fase = data.fase_gargalo ? limparNomeFase(data.fase_gargalo) : 'N/A';
        container.innerHTML = `
            <div class="dashboard-summary-row">
                <div><strong>Tempo médio do processo</strong><span>Leitura base do período atual</span></div>
                <div class="dashboard-summary-row__value">${leadTimeMedio} dias</div>
            </div>
            <div class="dashboard-summary-row">
                <div><strong>Tempo médio P90</strong><span>Faixa dos processos mais lentos</span></div>
                <div class="dashboard-summary-row__value">${leadTimeP90} dias</div>
            </div>
            <div class="dashboard-summary-row">
                <div><strong>Processos concluídos</strong><span>Total considerado no cálculo</span></div>
                <div class="dashboard-summary-row__value">${processos}</div>
            </div>
            <div class="dashboard-summary-row">
                <div><strong>Maior tempo registrado</strong><span>Pico extremo do recorte</span></div>
                <div class="dashboard-summary-row__value">${maiorTempoRegistrado} dias</div>
            </div>
            <div class="dashboard-summary-row">
                <div><strong>Fase gargalo (P90)</strong><span>Principal etapa a ser atacada</span></div>
                <div class="dashboard-summary-row__value">${fase}</div>
            </div>
        `;
    }

    function gerarCores(qtd) {
        const paleta = ['#4F81BD', '#C0504D', '#9BBB59', '#8064A2', '#4BACC6', '#F79646', '#92A9CF', '#D99694', '#C3D69B', '#B1A0C7', '#93CDDD'];
        const cores = [];
        for (let i = 0; i < qtd; i++) cores.push(paleta[i % paleta.length]);
        return cores;
    }

    function carregarGraficoTempoMedioFase(tempoMedioPorFase) {
        if (!Array.isArray(tempoMedioPorFase) || tempoMedioPorFase.length === 0) {
            const chartDiv = document.querySelector('#tempoMedioFaseChart');
            if (chartDiv) chartDiv.innerHTML = '<div style="text-align:center;color:#888;padding:40px 0;">Sem dados para exibir</div>';
            return;
        }

        tempoMedioPorFase.sort((a, b) => b.p90 - a.p90);
        const cores = gerarCores(tempoMedioPorFase.length);

        const options = {
            chart: { type: 'bar', height: 338, toolbar: { show: false } },
            plotOptions: { bar: { horizontal: true, borderRadius: 6, dataLabels: { position: 'top' }, distributed: true } },
            series: [{ name: 'P90 (dias)', data: tempoMedioPorFase.map(fase => Math.round(fase.p90)) }],
            xaxis: {
                categories: tempoMedioPorFase.map(fase => limparNomeFase(fase.nome)),
                labels: { style: { fontSize: '13px' }, rotate: 0, rotateAlways: false, hideOverlappingLabels: false, trim: true },
                axisBorder: { show: true, color: '#888' },
                axisTicks: { show: true, color: '#888' }
            },
            yaxis: { title: { text: 'Fases' }, labels: { style: { fontSize: '13px' } } },
            fill: { type: 'solid', colors: cores },
            colors: cores,
            dataLabels: {
                enabled: true,
                formatter: function (val) { return val + ' dias'; },
                offsetY: -20,
                style: { fontSize: '14px', colors: ['#333'] }
            },
            tooltip: {
                y: {
                    formatter: function (val, opts) {
                        const idx = opts.dataPointIndex;
                        const fase = tempoMedioPorFase[idx];
                        return `${limparNomeFase(fase.nome)}: ${Math.round(fase.p90)} dias (P90)`;
                    }
                }
            },
            grid: { borderColor: '#eee', row: { colors: ['#f9f9f9', 'transparent'], opacity: 0.5 } },
            legend: { show: false }
        };

        const chartDiv = document.querySelector('#tempoMedioFaseChart');
        renderApexChart(chartDiv, options);
    }

    async function carregarGraficoTempoMedioFasePizza(tempoPorFase) {
        try {
            const chartElement = document.querySelector('#totalDiasPorFaseChart');
            if (!chartElement) return;
            if (!Array.isArray(tempoPorFase) || tempoPorFase.length === 0) {
                chartElement.innerHTML = '<div style="text-align:center;color:#888;padding:40px 0;">Sem dados para exibir</div>';
                return;
            }

            const mediasPorFase = tempoPorFase
                .map(fase => {
                    const total = typeof fase.total === 'number' ? fase.total : 0;
                    const count = typeof fase.count === 'number' ? fase.count : 0;
                    const media = count > 0 ? total / count : 0;
                    return { nome: limparNomeFase(fase.nome), media, total, count };
                })
                .filter(fase => fase.count > 0);

            if (mediasPorFase.length === 0) {
                chartElement.innerHTML = '<div style="text-align:center;color:#888;padding:40px 0;">Sem dados para exibir</div>';
                return;
            }

            const options = {
                chart: {
                    type: 'donut',
                    height: 320,
                    toolbar: { show: false },
                    events: {
                        dataPointSelection: function (_event, _chartContext, config) {
                            const faseSelecionada = mediasPorFase?.[config.dataPointIndex]?.nome || '';
                            if (!faseSelecionada) return;
                            cronoFilters.fase = faseSelecionada === cronoFilters.fase ? '' : faseSelecionada;
                            carregarDadosDashboard();
                        }
                    }
                },
                plotOptions: { pie: { donut: { size: '68%' }, offsetX: 0 } },
                series: mediasPorFase.map(fase => Math.round(fase.media)),
                labels: mediasPorFase.map(fase => fase.nome),
                colors: gerarCores(mediasPorFase.length),
                fill: { opacity: 0.95 },
                dataLabels: {
                    enabled: true,
                    formatter: function (_value, opts) {
                        const fase = mediasPorFase[opts.seriesIndex];
                        if (!fase) return '';
                        return fase.media >= 8 ? `${Math.round(fase.media)}d` : '';
                    },
                    style: {
                        fontSize: '11px',
                        fontWeight: 700,
                        colors: ['#ffffff']
                    },
                    dropShadow: {
                        enabled: false
                    }
                },
                legend: {
                    position: 'bottom',
                    horizontalAlign: 'left',
                    fontSize: '10px',
                    width: 1000,
                    offsetX: 0,
                    offsetY: 10,
                    itemMargin: { vertical: 6, horizontal: 10 },
                    markers: { width: 11, height: 11, radius: 8 },
                    labels: { formatter: function(label) { return limparNomeFase(label); } }
                },
                tooltip: {
                    y: {
                        formatter: function (val, opts) {
                            const idx = opts.seriesIndex;
                            const fase = mediasPorFase[idx];
                            if (!fase) return '';
                            return `${fase.nome}: ${fase.media.toFixed(1)} dias (n=${fase.count})`;
                        }
                    }
                },
                responsive: [{
                    breakpoint: 1000,
                    options: {
                        chart: { width: '100%', height: 308 },
                        plotOptions: { pie: { offsetX: 0 } },
                        legend: { position: 'bottom', horizontalAlign: 'left', width: 320 }
                    }
                }]
            };

            renderApexChart(chartElement, options);
            organizarLegendaTempoMedioFase();
        } catch (error) {
            console.error('Erro ao renderizar o gráfico de pizza de tempo médio por fase:', error);
        }
    }

    function carregarGraficoEvolucao(dados) {
        try {
            if (!Array.isArray(dados) || dados.length === 0) {
                const chartDiv = document.querySelector('#evolucaoChart');
                if (chartDiv) chartDiv.innerHTML = '<div style="text-align:center;color:#888;padding:40px 0;">Sem dados para exibir</div>';
                return;
