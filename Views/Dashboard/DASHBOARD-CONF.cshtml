    async function fetchTaxaConformidade() {
        try {
            const response = await fetch(`/api/taxa-conformidade${buildFilterQuery(confFilters)}`);
            if (!response.ok) throw new Error('Erro ao buscar taxa de conformidade');

            const data = await response.json();
            if (typeof data.taxa !== 'number' || typeof data.total_avaliados !== 'number' || typeof data.conformes !== 'number' || typeof data.nao_conformes !== 'number') {
                throw new Error('Formato de dados inválido');
            }

            dashboardState.taxaConformidade = data.taxa;
            dashboardState.totalAvaliados = data.total_avaliados;
            dashboardState.totalConformidades = data.conformes;
            dashboardState.totalNaoConformidades = data.nao_conformes;
            updateKpiCards();
        } catch (error) {
            console.error('Erro ao carregar taxa de conformidade:', error);
            setText('taxaConformidade', 'Erro');
            setText('taxaConformidadeMudanca', 'Erro ao carregar dados');
        }
    }

    async function fetchTopCategoriasNaoConformidades() {
        try {
            const query = buildFilterQuery({ ...confFilters, top: '10' });
            const response = await fetch(`/api/top-categorias-nao-conformidades${query}`);
            if (!response.ok) throw new Error('Erro ao buscar categorias com mais não conformidades');

            const data = await response.json();
            const categorias = Array.isArray(data) ? [...data] : [];
            categorias.sort((a, b) => (b.total_nao_conformidades || 0) - (a.total_nao_conformidades || 0));
            const topCategorias = categorias.slice(0, 10);
            dashboardState.topCategoriasData = topCategorias;

            if (topCategorias[0]) {
                const principal = topCategorias[0];
                setExecutiveBrief(
                    'briefCategoriaCritica',
                    principal.categoria || 'Sem categoria',
                    'briefCategoriaCriticaMeta',
                    `${principal.total_nao_conformidades || 0} NC, equivalente a ${(principal.percentual_total_nc || 0).toFixed(1)}% do total do período.`
                );
            }

            renderTopCategoriasChart(topCategorias);
            renderTopCategoriasTable(topCategorias);
            renderCategoriasDonut(topCategorias);
            renderSupplementaryCards();
        } catch (error) {
            console.error('Erro ao carregar categorias com mais não conformidades:', error);
        }
    }

    function renderSupplementaryCards() {
        renderRecorrenciaChart();
        renderPriorityList();
        renderActionMetrics();
    }

    function renderRecorrenciaChart() {
        const target = document.querySelector('#recorrenciaNcChart');
        if (!target) return;

        destroyChart(target);

        const topCategorias = Array.isArray(dashboardState.topCategoriasData) ? dashboardState.topCategoriasData.slice(0, 3) : [];
        if (!topCategorias.length) {
            target.innerHTML = '<div style="text-align:center;color:#888;padding:32px 0;">Sem dados para exibir</div>';
            setText('recorrenciaTitulo', 'Sem recorrência crítica');
            setText('recorrenciaResumo', 'Não há categorias suficientes para calcular a recorrência no período.');
            return;
        }

        const totalNc = topCategorias.reduce((acc, item) => acc + (item.total_nao_conformidades || 0), 0);
        const series = topCategorias.map(item => item.total_nao_conformidades || 0);
        const labels = topCategorias.map((item, index) => `${index + 1}ª ocorrência`);

        renderApexChart(target, {
            chart: {
                type: 'donut',
                height: 220,
                toolbar: { show: false }
            },
            series,
            labels,
            colors: ['#ff5b6e', '#ff9b2f', '#f4c542'],
            legend: {
                position: 'right',
                fontSize: '12px',
                labels: { colors: getChartFontColor() }
            },
            plotOptions: {
                pie: {
                    donut: {
                        size: '62%',
                        labels: {
                            show: true,
                            total: {
                                show: true,
                                label: 'Total NC',
                                color: getChartFontColor(),
                                formatter: function () {
                                    return formatarNumeroGrafico(totalNc);
                                }
                            }
                        }
                    }
                }
            },
            dataLabels: {
                enabled: true,
                formatter: function (_value, opts) {
                    const atual = series[opts.seriesIndex] || 0;
                    const percentual = totalNc > 0 ? (atual / totalNc) * 100 : 0;
                    return `${percentual.toFixed(1)}%`;
                }
            },
            tooltip: { ...getTooltipTheme(), y: { formatter: val => `${formatarNumeroGrafico(val)} não conformidades` } },
            stroke: { width: 3, colors: ['#ffffff'] }
        }).render();

        const principal = topCategorias[0];
        const percentualPrincipal = totalNc > 0 ? ((principal.total_nao_conformidades || 0) / totalNc) * 100 : 0;
        setText('recorrenciaTitulo', principal?.categoria || 'Sem categoria');
        setText('recorrenciaResumo', `${principal?.total_nao_conformidades || 0} não conformidades (${percentualPrincipal.toFixed(1)}%) concentradas na principal causa do período.`);
    }

    function renderPriorityList() {
        const container = document.getElementById('dashboardPriorityList');
        if (!container) return;

        const prioridades = (dashboardState.topCategoriasData || []).slice(0, 4);
        if (!prioridades.length) {
            container.innerHTML = '<div class="dashboard-priority-row dashboard-priority-row--empty">Sem prioridades calculadas.</div>';
            return;
        }

        container.innerHTML = prioridades.map((item, index) => {
            const taxa = item.percentual_total_nc || 0;
            const nivel = index === 0 ? 'Alta' : (index === 1 ? 'Média' : 'Atenção');
            const tendencia = taxa >= 10 ? '↑' : (taxa >= 5 ? '→' : '↓');
            const tendenciaClasse = taxa >= 10 ? 'danger' : (taxa >= 5 ? 'warning' : 'success');

            return `
                <div class="dashboard-priority-row">
                    <span class="dashboard-priority-row__badge dashboard-priority-row__badge--${index === 0 ? 'danger' : (index === 1 ? 'warning' : 'neutral')}">${nivel}</span>
                    <div class="dashboard-priority-row__content">
                        <strong>${item.categoria || 'Sem categoria'}</strong>
                        <span>${item.total_nao_conformidades || 0} NC, representando ${taxa.toFixed(1)}% do total</span>
                    </div>
                    <div class="dashboard-priority-row__trend dashboard-priority-row__trend--${tendenciaClasse}">
                        ${tendencia} ${taxa.toFixed(1)}%
                    </div>
                </div>
            `;
        }).join('');
    }

    function renderActionMetrics() {
        const totalNc = dashboardState.totalNaoConformidades || 0;
        const totalConformes = dashboardState.totalConformidades || 0;
        const categoriasCriticas = (dashboardState.topCategoriasData || []).slice(0, 4);
        const abertas = categoriasCriticas.reduce((acc, item) => acc + Math.ceil((item.total_nao_conformidades || 0) / 12), 0);
        const concluidas = Math.max(0, Math.round(abertas * ((dashboardState.taxaConformidade || 0) / 100)));
        const eficacia = totalNc + totalConformes > 0 ? (totalConformes / (totalConformes + totalNc)) * 100 : 0;
        const tempoMedio = categoriasCriticas.length ? Math.max(3, Math.round(30 / categoriasCriticas.length)) : 0;

        setText('acoesAbertasValor', String(abertas));
        setText('acoesAbertasMeta', abertas > 0 ? 'Demandas em acompanhamento' : 'Sem ações pendentes');
        setText('acoesConcluidasValor', String(concluidas));
        setText('acoesConcluidasMeta', 'Estimativa com base na estabilidade atual');
        setText('acoesEficaciaValor', `${eficacia.toFixed(1)}%`);
        setText('acoesEficaciaMeta', 'Indicador sintético de resposta');
        setText('acoesTempoMedioValor', `${tempoMedio} dias`);
        setText('acoesTempoMedioMeta', 'Janela média projetada');
    }

    function renderTopCategoriasChart(data) {
        const chartElement = document.querySelector('#topCategoriasChart');
        if (!chartElement) return;

        destroyChart(chartElement);

        if (!Array.isArray(data) || data.length === 0) {
            chartElement.innerHTML = '<div style="text-align:center;color:#888;padding:40px 0;">Sem dados para exibir</div>';
            return;
        }

        const categorias = data.map(item => item.categoria || 'Sem categoria');
        const volumes = data.map(item => item.total_nao_conformidades || 0);
        const acumuladoTotal = volumes.reduce((acc, value) => acc + value, 0);
        let acumuladoAtual = 0;
        const serieAcumulada = volumes.map(value => {
            acumuladoAtual += value;
            return acumuladoTotal > 0 ? (acumuladoAtual / acumuladoTotal) * 100 : 0;
        });

        renderApexChart(chartElement, {
            chart: {
                type: 'line',
                height: 292,
                toolbar: { show: false },
                events: {
                    dataPointSelection: function (_event, _chartContext, config) {
                        const categoriaSelecionada = data?.[config.dataPointIndex]?.categoria || '';
                        if (!categoriaSelecionada) return;
                        confFilters.categoria = categoriaSelecionada === confFilters.categoria ? '' : categoriaSelecionada;
                        recarregarDashboardConf();
                    }
                }
            },
            series: [
                { name: 'Não conformidades', type: 'bar', data: volumes },
                { name: '% acumulado', type: 'line', data: serieAcumulada }
            ],
            xaxis: { categories: categorias, labels: { rotate: -35, style: { fontSize: '12px', colors: getChartFontColor() } } },
            yaxis: [
                {
                    title: { text: 'Não conformidades' },
                    labels: { style: { fontSize: '12px', colors: [getChartFontColor()] } }
                },
                {
                    opposite: true,
                    max: 100,
                    title: { text: '% acumulado' },
                    labels: {
                        formatter: value => `${value.toFixed(0)}%`,
                        style: { fontSize: '12px', colors: [getChartFontColor()] }
                    }
                }
            ],
            plotOptions: { bar: { columnWidth: '52%', borderRadius: 6 } },
            stroke: { width: [0, 3], curve: 'smooth' },
            colors: ['#8b6fd8', '#1696c4'],
            fill: { type: ['solid', 'solid'] },
            dataLabels: { enabled: false },
            markers: { size: [0, 4] },
            tooltip: {
                ...getTooltipTheme(),
                shared: true,
                intersect: false,
                y: {
                    formatter: (val, { seriesIndex }) => seriesIndex === 1 ? `${formatarNumeroGrafico(val, 1)}% acumulado` : `${formatarNumeroGrafico(val)} não conformidades`
                }
            },
            grid: { borderColor: getGridColor(), strokeDashArray: 4 },
            legend: { position: 'bottom', horizontalAlign: 'center' },
            noData: { text: 'Sem dados para exibir' }
        });
    }

    function renderTopCategoriasTable(data) {
        const tbody = document.querySelector('#topCategoriasTable tbody');
        if (!tbody) return;

        tbody.innerHTML = '';
        if (!Array.isArray(data) || data.length === 0) {
            const tr = document.createElement('tr');
            tr.innerHTML = '<td colspan="4" style="text-align:center;color:#888;">Sem dados</td>';
            tbody.appendChild(tr);
            return;
        }

        data.forEach((item, idx) => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${idx + 1}</td>
                <td>${item.categoria || 'Sem categoria'}</td>
                <td>${item.total_nao_conformidades || 0}</td>
                <td>${(item.percentual_total_nc || 0).toFixed(1)}%</td>
            `;
            tbody.appendChild(tr);
        });
    }

    function renderCategoriasDonut(data) {
        const chartElement = document.querySelector('#naoConformidadesCategoriaChart');
        if (!chartElement) return;

        destroyChart(chartElement);

        if (!Array.isArray(data) || data.length === 0) {
            chartElement.innerHTML = '<div style="text-align:center;color:#888;padding:40px 0;">Sem dados para exibir</div>';
            return;
        }

        const series = data.map(item => item.total_nao_conformidades || 0);
        const labels = data.map(item => item.categoria || 'Sem categoria');

        renderApexChart(chartElement, {
            chart: {
                type: 'donut',
                height: 292,
                toolbar: { show: false },
                events: {
                    dataPointSelection: function (_event, _chartContext, config) {
                        const categoriaSelecionada = data?.[config.dataPointIndex]?.categoria || '';
                        if (!categoriaSelecionada) return;
                        confFilters.categoria = categoriaSelecionada === confFilters.categoria ? '' : categoriaSelecionada;
                        recarregarDashboardConf();
                    }
                }
            },
            series,
            labels,
            legend: {
                position: 'right',
                fontSize: '12px',
                labels: { colors: getChartFontColor() }
            },
            colors: ['#8b5fd3', '#b58adf', '#ffb340', '#6ec24a', '#3b82f6', '#9fb6ff', '#ef4444', '#14b8a6'],
            plotOptions: {
                pie: {
                    donut: {
                        size: '68%',
                        labels: {
                            show: true,
                            total: {
                                show: true,
                                label: 'Total NC',
                                color: getChartFontColor(),
                                formatter: function () {
                                    return formatarNumeroGrafico(series.reduce((acc, value) => acc + value, 0));
                                }
                            },
                            value: {
                                color: getChartFontColor(),
                                formatter: function (value) {
                                    return formatarNumeroGrafico(value);
                                }
                            }
                        }
                    }
                }
            },
            dataLabels: {
                enabled: true,
                formatter: function (_value, opts) {
                    const total = series.reduce((acc, value) => acc + value, 0);
                    const atual = series[opts.seriesIndex] || 0;
                    const percentual = total > 0 ? (atual / total) * 100 : 0;
                    return `${percentual.toFixed(1)}%`;
                },
                style: { fontSize: '11px', fontWeight: 700 }
            },
            tooltip: { ...getTooltipTheme(), y: { formatter: val => `${formatarNumeroGrafico(val)} não conformidades` } },
            stroke: { width: 3, colors: ['#ffffff'] },
            noData: { text: 'Sem dados para exibir' }
        });
    }

    function updateExecutiveDirection() {
        if (dashboardState.taxaConformidade === null || dashboardState.totalNaoConformidades === null) {
            return;
        }

        if (dashboardState.taxaConformidade >= 95 && dashboardState.totalNaoConformidades <= 3) {
            setExecutiveBrief('briefDirecao', 'Cenario controlado', 'briefDirecaoMeta', 'Qualidade alta, com baixo volume de desvios e boa estabilidade operacional.');
            return;
        }

        if (dashboardState.taxaConformidade >= 90) {
            setExecutiveBrief('briefDirecao', 'Atencao moderada', 'briefDirecaoMeta', 'A base segue saudavel, mas ja existe concentracao de desvios que pede ajuste fino.');
            return;
        }

        setExecutiveBrief('briefDirecao', 'Intervencao recomendada', 'briefDirecaoMeta', 'A taxa atual indica necessidade de atuar nas causas-raiz e nas frentes com maior recorrencia.');
    }

    document.addEventListener('DOMContentLoaded', async function () {
        hydrateFiltersFromUrl();
        ensureMetricCardShells();
        await carregarFiltrosConf();
        syncFiltersToInputs();
        document.getElementById('confAplicarFiltros')?.addEventListener('click', function () {
            syncInputsToFilters();
            recarregarDashboardConf();
        });
        ['confArea', 'confModalidade', 'confDataInicio', 'confDataFim'].forEach(id => {
            document.getElementById(id)?.addEventListener('change', function () {
                syncInputsToFilters();
                recarregarDashboardConf();
            });
        });
        document.getElementById('confLimparFiltros')?.addEventListener('click', function () {
            ['confArea', 'confModalidade', 'confDataInicio', 'confDataFim'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.value = '';
            });
            confFilters.area = '';
            confFilters.modalidade = '';
            confFilters.dataInicio = '';
            confFilters.dataFim = '';
            confFilters.categoria = '';
            recarregarDashboardConf();
        });
        await recarregarDashboardConf();
    });

    document.addEventListener('DOMContentLoaded', function () {
        const p = chartPalette;
        renderMetricSpark('sparkChecklists', [18, 24, 22, 30, 27, 33, 29], p.violet, 'area');
        renderMetricSpark('sparkConformidades', [32, 38, 36, 42, 46, 44, 48], p.cyan, 'area');
        renderMetricSpark('sparkNaoConformes', [9, 12, 11, 14, 10, 13, 8], p.indigo, 'area');
        renderMetricSpark('sparkTaxa', [42, 58, 54, 67, 61], p.blue, 'bar');
    });
    </script>

    <script>
    (function () {
        const originalRenderMetricSpark = window.renderMetricSpark;
        const originalUpdateKpiCards = window.updateKpiCards;

        window.ensureMetricCardShells = function () {
            const cards = Array.from(document.querySelectorAll('.dashboard-metrics .metric-card'));
            const configs = [
                { cls: 'metric-card--spark metric-card--violet', icon: 'fa-chart-line', sparkId: 'sparkChecklists', footer: 'Volume diário' },
                { cls: 'metric-card--spark metric-card--cyan', icon: 'fa-wave-square', sparkId: 'sparkConformidades', footer: 'Tendência positiva' },
                { cls: 'metric-card--spark metric-card--indigo', icon: 'fa-chart-line', sparkId: 'sparkNaoConformes', footer: 'Desvios mapeados' },
                { cls: 'metric-card--spark metric-card--slim', icon: 'fa-bullseye', sparkId: 'sparkTaxa', footer: 'Eficiência atual', radial: true }
            ];

            cards.forEach((card, index) => {
                const title = card.querySelector('.metric-card__title');
                const meta = card.querySelector('.metric-card__meta');
                if (!title || !meta || card.querySelector('.metric-card__header')) {
                    return;
                }

                const config = configs[index];
                const sparkClass = config?.radial
                    ? 'metric-card__spark--radial'
                    : (config?.bars ? 'metric-card__spark--bars' : '');

                card.className = `metric-card ${config.cls}`;
                title.insertAdjacentHTML('beforebegin', '<div class="metric-card__header"></div>');
                const header = card.querySelector('.metric-card__header');
                header.appendChild(title);
                header.insertAdjacentHTML('beforeend', `<span class="metric-card__chip"><i class="fas ${config.icon}"></i></span>`);
                meta.insertAdjacentHTML('afterend', `<div id="${config.sparkId}" class="metric-card__spark ${sparkClass}"></div><span class="metric-card__footer">${config.footer}</span>`);
            });
        };

        window.renderMetricSpark = function (targetId, series, color, type) {
            if (type !== 'radial') {
                return originalRenderMetricSpark(targetId, series, color, type);
            }

            const target = document.getElementById(targetId);
            if (!target) {
                return;
            }

            if (typeof destroyChart === 'function') {
                destroyChart(target);
            }

            target.innerHTML = '';

            const rawValue = Array.isArray(series) && series.length ? Number(series[0]) : 0;
            const percent = Number.isFinite(rawValue) ? Math.max(0, Math.min(100, rawValue)) : 0;
            const palette = typeof getActivePalette === 'function' ? chartPalette : null;
            const labelColor = '#14213d';
            const trackColor = 'rgba(148, 163, 184, 0.22)';

            renderApexChart(target, {
                chart: {
                    type: 'radialBar',
                    height: 78,
                    sparkline: { enabled: true },
                    toolbar: { show: false }
                },
                series: [percent],
                colors: [color || palette?.blue || '#4facfe'],
                plotOptions: {
                    radialBar: {
                        startAngle: -110,
                        endAngle: 110,
                        hollow: { size: '58%' },
                        track: { background: trackColor, strokeWidth: '96%' },
                        dataLabels: {
                            name: { show: false },
                            value: {
                                offsetY: 4,
                                fontSize: '0.8rem',
                                fontWeight: 700,
                                color: labelColor,
                                formatter: function (value) {
                                    return `${Math.round(value)}%`;
                                }
                            }
                        }
                    }
                },
                stroke: { lineCap: 'round' },
                tooltip: { enabled: false }
            });
        };

        window.updateKpiCards = function () {
            originalUpdateKpiCards();
            updateExecutiveDirection();

            if (dashboardState.taxaConformidade !== null && dashboardState.taxaConformidade !== undefined) {
                const palette = typeof getActivePalette === 'function' ? chartPalette : null;
                window.renderMetricSpark('sparkTaxa', [dashboardState.taxaConformidade], palette?.blue || '#4facfe', 'radial');
            }
        };

        document.addEventListener('DOMContentLoaded', function () {
            const palette = typeof getActivePalette === 'function' ? chartPalette : null;
            window.renderMetricSpark('sparkChecklists', [18, 24, 22, 30, 27, 33, 29], palette?.violet || '#c158ff', 'area');
            window.renderMetricSpark('sparkConformidades', [32, 38, 36, 42, 46, 44, 48], palette?.cyan || '#2ad6ff', 'area');
            window.renderMetricSpark('sparkNaoConformes', [5, 9, 8, 11, 7, 10, 4], palette?.indigo || '#8b93ff', 'area');
            window.renderMetricSpark('sparkTaxa', [dashboardState.taxaConformidade ?? 0], palette?.blue || '#4facfe', 'radial');
        });

        document.addEventListener('DOMContentLoaded', function () {
            const storageKey = 'dashboard-conf-active-tab';
            const navLinks = Array.from(document.querySelectorAll('[data-dashboard-tab]'));
            const panels = Array.from(document.querySelectorAll('[data-dashboard-panel]'));

            if (!navLinks.length || !panels.length) {
                return;
            }

            function setActiveTab(tabId) {
                navLinks.forEach(link => {
                    const isActive = link.getAttribute('data-dashboard-tab') === tabId;
                    link.classList.toggle('is-active', isActive);
                    link.setAttribute('aria-selected', isActive ? 'true' : 'false');
                });

                panels.forEach(panel => {
                    const isActive = panel.getAttribute('data-dashboard-panel') === tabId;
                    panel.classList.toggle('is-active', isActive);
                    panel.hidden = !isActive;
                });

                try {
                    localStorage.setItem(storageKey, tabId);
                } catch (_error) {
                }
            }

            navLinks.forEach(link => {
                link.addEventListener('click', function () {
                    const targetId = this.getAttribute('data-dashboard-tab');
                    if (targetId) {
                        setActiveTab(targetId);
                    }
                });
            });

            let initialTab = navLinks[0].getAttribute('data-dashboard-tab');
            try {
                const savedTab = localStorage.getItem(storageKey);
                if (savedTab && panels.some(panel => panel.getAttribute('data-dashboard-panel') === savedTab)) {
                    initialTab = savedTab;
                }
            } catch (_error) {
            }

            if (initialTab) {
                setActiveTab(initialTab);
            }
        });
    })();
    </script>

}



